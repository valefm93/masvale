---
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource-variable/inter';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '@vercel/analytics/astro';

interface Props {
  title?: string;
  description?: string;
  /** En la home el header flota transparente sobre el hero */
  overlayHeader?: boolean;
  /** Oculta el footer (la home, por ahora, es solo el hero) */
  hideFooter?: boolean;
  /** Imagen para compartir en redes (ruta dentro de /public) */
  image?: string;
}

const {
  title,
  overlayHeader = false,
  hideFooter = false,
  image = '/images/hero/landscape.jpg',
  description = 'Vale Ferreira — Product Designer. UX/UI, prototyping, user testing and branding.',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Vale Ferreira',
  jobTitle: 'Product Designer',
  url: 'https://www.vale-ferreira.com',
  sameAs: ['https://www.linkedin.com/in/valefm93/', 'https://www.behance.net/valefm93'],
};
const fullTitle = title ? `${title} · Vale Ferreira` : 'Vale Ferreira · Product Designer';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <Analytics />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header overlay={overlayHeader} />
    <main id="main">
      <slot />
    </main>
    {!hideFooter && <Footer />}
  </body>
</html>

<script>
  // "Let's talk" (#contact): el footer queda pegado abajo (footer reveal), así que el salto normal del
  // navegador no llega. Se baja hasta el final de la página; si la página no tiene footer (la home),
  // se va al de /resume.
  {
    const toContact = (smooth: boolean) => {
      const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      // 'instant' y no 'auto': con scroll-behavior: smooth en el html, 'auto' también se animaría
      window.scrollTo({ top: document.documentElement.scrollHeight, behavior: smooth && !still ? 'smooth' : 'instant' });
    };
    document.addEventListener('click', (e) => {
      const a = (e.target as Element).closest<HTMLAnchorElement>('a[href$="#contact"]');
      if (!a || e.metaKey || e.ctrlKey) return;
      const url = new URL(a.href);
      if (url.pathname !== location.pathname) return;
      e.preventDefault();
      if (!document.getElementById('contact')) {
        location.href = '/resume#contact';
        return;
      }
      history.replaceState(null, '', '#contact');
      toContact(true);
    });
    if (location.hash === '#contact' && document.getElementById('contact')) {
      toContact(false);
      // las imágenes que cargan después cambian el alto de la página: se vuelve a bajar
      window.addEventListener('load', () => toContact(false), { once: true });
    }
  }

  // Footer reveal: solo si el footer cabe entero en la pantalla (si no, se comporta normal).
  // Mientras se destapa, --r avanza de 0 a 1 y el footer pasa de lima a oscuro (ver Footer.astro).
  const footerEl = document.querySelector<HTMLElement>('footer');
  const mainEl = document.querySelector<HTMLElement>('main');
  if (footerEl && mainEl) {
    const paint = () => {
      const reveal = footerEl.classList.contains('is-reveal');
      const shown = (window.innerHeight - mainEl.getBoundingClientRect().bottom) / footerEl.offsetHeight;
      footerEl.style.setProperty('--r', reveal ? String(Math.min(1, Math.max(0, shown))) : '1');
    };
    const fit = () => {
      footerEl.classList.toggle('is-reveal', footerEl.offsetHeight <= window.innerHeight + 1);
      paint();
    };
    fit();
    window.addEventListener('resize', fit);
    window.addEventListener('scroll', paint, { passive: true });
  }

  // Activa las micro-animaciones de entrada (ver data-reveal en global.css)
  const targets = document.querySelectorAll('[data-reveal]');
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        entry.target.classList.add('is-visible');
        observer.unobserve(entry.target);
      }
    },
    { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
  );
  targets.forEach((el) => observer.observe(el));

  // Mensajes tipo máquina de escribir (ver .type-msg en global.css)
  const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const touch = window.matchMedia('(hover: none)').matches;
  document.querySelectorAll<HTMLElement>('[data-typewriter]').forEach((host) => {
    const typed = host.querySelector<HTMLElement>('[data-typed]');
    if (!typed) return;
    const text = host.dataset.text ?? '';
    let timer: number | undefined;

    const start = () => {
      window.clearInterval(timer);
      host.classList.add('is-typing');
      if (still) {
        typed.textContent = text;
        return;
      }
      let i = 0;
      typed.textContent = '';
      timer = window.setInterval(() => {
        typed.textContent = text.slice(0, ++i);
        if (i >= text.length) window.clearInterval(timer);
      }, 28);
    };
    const stop = () => {
      window.clearInterval(timer);
      host.classList.remove('is-typing');
    };

    if (!touch) {
      host.addEventListener('mouseenter', start);
      host.addEventListener('mouseleave', stop);
      host.addEventListener('focusin', start);
      host.addEventListener('focusout', stop);
    } else if (host.dataset.typewriter === 'auto') {
      // En pantallas táctiles no hay hover: se escribe una vez al entrar a la página
      window.setTimeout(start, 700);
    } else {
      // ...o se abre y se cierra tocando
      host.addEventListener('click', () => (host.classList.contains('is-typing') ? stop() : start()));
    }
  });
</script>

<style>
  .skip-link {
    position: absolute;
    left: var(--space-4);
    top: -100px;
    padding: var(--space-2) var(--space-4);
    background: var(--color-text);
    color: var(--color-bg);
    border-radius: var(--radius-sm);
    z-index: 100;
  }
  .skip-link:focus {
    top: var(--space-4);
  }
</style>
