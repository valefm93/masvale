---
import Base from '../../layouts/Base.astro';
import Pill from '../../components/Pill.astro';
import Gallery from '../../components/Gallery.astro';
import RichText from '../../components/RichText.astro';
import { projects, type Project } from '../../data/projects';

export function getStaticPaths() {
  // Los proyectos con página propia (custom) no pasan por esta plantilla
  return projects.filter((p) => !p.custom).map((project) => ({
    params: { slug: project.slug },
    props: { project, next: projects[(projects.indexOf(project) + 1) % projects.length] },
  }));
}

interface Props {
  project: Project;
  next: Project;
}
const { project, next } = Astro.props;

// Proyectos que no son case study: texto a la izquierda, imágenes a la derecha.
const textBlocks = project.blocks.filter((b) => b.type === 'text' || b.type === 'list');
const images = [
  { src: project.cover, alt: project.title },
  ...project.blocks.flatMap((b) =>
    b.type === 'image' ? [{ src: b.src, alt: b.alt }] : b.type === 'gallery' ? b.images : [],
  ),
].filter((img, i, all) => all.findIndex((other) => other.src === img.src) === i);
---

<Base title={project.client} description={project.summary} image={project.cover}>
  {
    project.caseStudy ? (
      <Fragment>
      <header class="container head" data-reveal>
        <a class="back" href="/portfolio">← All projects</a>
        <p class="eyebrow">{project.client}</p>
        <h1>{project.title}</h1>
        <p class="summary">{project.summary}</p>
        <div class="tags">{project.tags.map((t) => <Pill tone="accent">{t}</Pill>)}</div>
      </header>

      <div class="cover container" data-reveal style="--reveal-i:1">
        <img src={project.cover} alt="" />
      </div>

      <article class="blocks">
        {
          project.blocks.map((b) => {
            if (b.type === 'text')
              return (
                <section class="container text" data-reveal>
                  {b.title ? <h2>{b.title}</h2> : <span />}
                  <div class="prose">
                    {b.body.map((t) => (
                      <RichText text={t} />
                    ))}
                  </div>
                </section>
              );
            if (b.type === 'list')
              return (
                <section class="container text" data-reveal>
                  {b.title ? <h2>{b.title}</h2> : <span />}
                  <ul class="prose bullets">
                    {b.items.map((t) => (
                      <RichText as="li" text={t} />
                    ))}
                  </ul>
                </section>
              );
            if (b.type === 'pills')
              return (
                <section class="container text" data-reveal>
                  {b.title ? <h2>{b.title}</h2> : <span />}
                  <div class="pills">
                    {b.items.map((t) => (
                      <Pill>{t}</Pill>
                    ))}
                  </div>
                </section>
              );
            if (b.type === 'image')
              return (
                <figure class="container image" data-reveal>
                  <img src={b.src} alt={b.alt} loading="lazy" />
                  {b.caption && <figcaption>{b.caption}</figcaption>}
                </figure>
              );
            if (b.type === 'gallery')
              return (
                <section class="gallery-block" data-reveal>
                  {b.title && <h2 class="container gallery-title">{b.title}</h2>}
                  <Gallery images={b.images} label={b.title ?? `${project.client} gallery`} />
                </section>
              );
          })
        }
      </article>
      </Fragment>
    ) : (
      <div class="container simple">
        <div class="side" data-reveal>
          <a class="back" href="/portfolio">← All projects</a>
          <p class="eyebrow">{project.client}</p>
          <h1>{project.title}</h1>
          <div class="side-text">
            {textBlocks.map((b) => (
              <div class="prose">
                {b.title && <h2>{b.title}</h2>}
                {b.type === 'text' && b.body.map((t) => <RichText text={t} />)}
                {b.type === 'list' && (
                  <ul class="bullets">
                    {b.items.map((t) => (
                      <RichText as="li" text={t} />
                    ))}
                  </ul>
                )}
              </div>
            ))}
          </div>
          <div class="tags">{project.tags.map((t) => <Pill tone="accent">{t}</Pill>)}</div>
        </div>
        <div class="media">
          {images.map((img, i) => <img src={img.src} alt={img.alt} loading={i === 0 ? 'eager' : 'lazy'} data-reveal style={i === 0 ? '--reveal-i:1' : undefined} />)}
        </div>
      </div>
    )
  }

  <nav class="container next" aria-label="Next project">
    <p class="eyebrow">Next project</p>
    <a href={`/projects/${next.slug}`}>{next.title} <span aria-hidden="true">→</span></a>
  </nav>
</Base>

<style>
  .head {
    padding-block: var(--space-16) var(--space-12);
  }
  .back {
    display: inline-block;
    margin-bottom: var(--space-12);
    font-size: var(--text-sm);
    color: var(--color-muted);
    text-decoration: none;
  }
  .back:hover {
    color: var(--color-text);
  }
  h1 {
    margin-top: var(--space-3);
    max-width: 16ch;
    font-size: var(--text-2xl);
  }
  .summary {
    margin-top: var(--space-6);
    max-width: 52ch;
    font-size: var(--text-lg);
    color: var(--color-muted);
  }
  /* Plantilla simple (no case study): columna de texto angosta + columna de imágenes */
  .simple {
    display: grid;
    grid-template-columns: var(--col-4) minmax(0, 1fr);
    gap: var(--grid-gap);
    align-items: start;
    padding-block: var(--space-12) var(--space-section);
  }
  /* La columna de texto queda fija y, si el texto es largo, tiene su propio scroll */
  .side {
    position: sticky;
    top: calc(64px + var(--space-8));
    max-height: calc(100svh - 64px - var(--space-8));
    padding: 0 var(--space-8) var(--space-8) 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: var(--color-line) transparent;
  }
  .side .back {
    margin-bottom: var(--space-8);
  }
  .side h1 {
    font-size: var(--text-xl);
  }
  .side h2 {
    font-size: var(--text-base);
    letter-spacing: -0.01em;
    color: var(--color-text);
  }
  .side-text {
    display: grid;
    gap: var(--space-6);
    margin-top: var(--space-6);
    font-size: var(--text-sm);
  }
  .media {
    display: grid;
    gap: var(--grid-gap);
  }
  .media img {
    width: 100%;
  }
  .tags,
  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .tags {
    margin-top: var(--space-8);
  }
  .cover img {
    width: 100%;
  }
  .blocks {
    display: grid;
    gap: var(--space-16);
    padding-block: var(--space-section);
  }
  .text {
    display: grid;
    grid-template-columns: var(--col-4) 1fr;
    gap: var(--grid-gap);
  }
  h2 {
    font-size: var(--text-xl);
  }
  .prose {
    display: grid;
    gap: var(--space-4);
    max-width: 62ch;
    color: var(--color-muted);
  }
  .prose :global(strong) {
    color: var(--color-text);
  }
  .bullets {
    margin: 0;
    padding-left: 1.2em;
  }
  .image {
    margin-block: 0;
  }
  .image img {
    width: 100%;
  }
  figcaption {
    margin-top: var(--space-3);
    font-size: var(--text-xs);
    color: var(--color-muted);
  }
  .gallery-title {
    margin-bottom: var(--space-6);
  }
  /* Next project: franja gris claro, para separarla del proyecto y del footer */
  .next {
    padding-block: var(--space-16);
    background: var(--gray-light);
  }
  .next a {
    display: inline-block;
    margin-top: var(--space-3);
    font-size: var(--text-2xl);
    font-weight: var(--weight-heading);
    line-height: var(--leading-tight);
    letter-spacing: -0.03em;
    text-decoration: none;
  }
  .next a:hover {
    background: var(--color-accent);
    color: var(--color-on-accent);
  }
  @media (max-width: 860px) {
    .simple {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
    .side {
      position: static;
      max-height: none;
      padding: 0;
      overflow: visible;
    }
  }
  @media (max-width: 760px) {
    .text {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
  }
</style>
