---
// Página propia de Chefy (AI cooking app): descripción, marca y design system.
// Los componentes están recreados en HTML/CSS con src/styles/chefy.css.
import '../../styles/chefy.css';
import Base from '../../layouts/Base.astro';
import ProjectSplit from '../../components/ProjectSplit.astro';
import { projects } from '../../data/projects';
import { cdn } from '../../data/assets';
import Screens from '../../components/chefy/Screens.astro';
import { svg } from '../../components/chefy/icons';

const project = projects.find((p) => p.slug === 'ai-cooking-app')!;
const next = projects[(projects.indexOf(project) + 1) % projects.length];
const screens = cdn('675eeac31745565ac3524abc_ai%20news%20app.jpg');

// Ficha del proyecto
const facts = [
  { label: 'Category', value: 'Food Technology & Artificial Intelligence' },
  { label: 'Platform', value: 'iOS & Android' },
  { label: 'Tools', value: 'Figma' },
];

// Decisiones de producto: todas se pueden ver en las pantallas del proyecto
const decisions = [
  {
    title: 'Three features, not ten',
    text: 'The sprint narrowed the MVP to what would prove the idea: a pantry to track what you have, AI recipes from those ingredients, and a daily cooking word game.',
  },
  {
    title: 'Your kitchen comes first',
    text: 'Onboarding asks for your appliances and gear before any recipe, so every suggestion is something you can actually make.',
  },
  {
    title: 'Say it or type it',
    text: 'Ingredients can be dictated or typed. Listing what is in the fridge should be as quick as saying it out loud.',
  },
  {
    title: 'Review before you cook',
    text: 'Ingredients, servings and cooking time are confirmed in two short steps, so the AI works from what you really have.',
  },
  {
    title: 'A character, not a chatbot',
    text: 'The assistant has a name and a face. Talking to a small robot chef feels lighter than filling in a form.',
  },
  {
    title: 'A reason to come back',
    text: 'You collect points as you use the app, and a daily word game adds a small habit around cooking at home.',
  },
];

// Paleta de Chefy: roles de color al estilo Material (color, "on", container, "on container")
const palette = [
  {
    title: 'Primary colors',
    rows: [
      { name: 'Primary', token: 'P-40', bg: '#BADC6A', fg: '#313A1B' },
      { name: 'On Primary', token: 'P-100', bg: '#313A1B', fg: '#BADC6A' },
      { name: 'Primary Container', token: 'P-90', bg: '#F7FAEE', fg: '#161F04' },
      { name: 'On Primary Container', token: 'P-10', bg: '#161F04', fg: '#FFFFFF' },
    ],
  },
  {
    title: 'Secondary colors',
    rows: [
      { name: 'Secondary', token: 'S-40', bg: '#122B3F', fg: '#FFFFFF' },
      { name: 'On Secondary', token: 'S-100', bg: '#FFFFFF', fg: '#122B3F' },
      { name: 'Secondary Container', token: 'S-90', bg: '#E7EAEC', fg: '#122B3F' },
      { name: 'On Secondary Container', token: 'S-10', bg: '#122B3F', fg: '#FFFFFF' },
    ],
  },
  {
    title: 'Tertiary colors',
    rows: [
      { name: 'Tertiary', token: 'T-40', bg: '#F4B556', fg: '#281903' },
      { name: 'On Tertiary', token: 'T-100', bg: '#281903', fg: '#F4B556' },
      { name: 'Tertiary Container', token: 'T-90', bg: '#FEF8ED', fg: '#281903' },
      { name: 'On Tertiary Container', token: 'T-10', bg: '#281903', fg: '#FFFFFF' },
    ],
  },
  {
    title: 'Surface colors',
    rows: [
      { name: 'Surface', token: 'N-98', bg: '#F7F7FD', fg: '#14141B' },
      { name: 'Surface Bright', token: 'N-98', bg: '#F9F9FF', fg: '#14141B' },
      { name: 'Surf. Container Lowest', token: 'N-100', bg: '#FFFFFF', fg: '#14141B' },
      { name: 'Surf. Container Low', token: 'N-96', bg: '#F3F3FA', fg: '#14141B' },
    ],
  },
];

---

<Base title="Chefy" description={project.summary}>
  <ProjectSplit project={project}>
    <Fragment slot="text">
      <p>
        I was part of the sprint sessions from the first day, and once the MVP was defined I designed for it: the
        naming, the branding and the design system the screens are built with.
      </p>
    </Fragment>
    <Fragment slot="extra">
      <dl class="facts">
        {
          facts.map((f) => (
            <div>
              <dt>{f.label}</dt>
              <dd>{f.value}</dd>
            </div>
          ))
        }
      </dl>

      <h2 class="side-title">Product decisions</h2>
      <ol class="decisions">
        {
          decisions.map((d) => (
            <li>
              <h3>{d.title}</h3>
              <p>{d.text}</p>
            </li>
          ))
        }
      </ol>
    </Fragment>

    <!-- Pantallas -->
    <section class="stage cf-vars" data-reveal style="--reveal-i:1">
      <div class="screens">
        <Screens />
      </div>
    </section>

    <!-- Branding -->
    <section class="kit cf-vars">
      <header class="kit-head" data-reveal>
        <h2>Branding</h2>
        <p>
          A name, a character and a short palette. Chefy turns the AI into someone you can talk to: a small robot chef
          that winks at you.
        </p>
      </header>
      <div class="kit-grid">
        <article class="card span-5 logo" data-reveal>
          <img src="/images/chefy/logo.svg" alt="Chefy logo: a robot chef mascot above the wordmark" loading="lazy" />
        </article>
        <article class="card span-7 naming" data-reveal>
          <p class="label">Naming</p>
          <p class="name">Chefy</p>
          <p class="note">
            A phonetic play on words: “chef” plus the ending <em>-y</em>, read as the diphthong /aɪ/, the same sound
            as “AI” said as a single word. Short enough to be an app icon, warm enough to be the name of the assistant
            itself.
          </p>
          <p class="label">Typography</p>
          <p class="note">A heavy rounded wordmark for the logo. Inter for everything inside the app.</p>
          <p class="inter cf">Aa Bb Cc 0123</p>
        </article>
        <article class="card span-12" data-reveal>
          <p class="label">Color</p>
          <div class="roles">
            {
              palette.map((g) => (
                <div class="role-group">
                  <p class="role-title">{g.title}</p>
                  <ul class="role-stack">
                    {g.rows.map((r) => (
                      <li style={`background:${r.bg}; color:${r.fg}`}>
                        <span>{r.name}</span>
                        <span class="tok">{r.token}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </div>
        </article>
      </div>
    </section>

    <img class="shot" src={screens} alt="Eight screens of the Chefy app" loading="lazy" data-reveal />

    <!-- Design system -->
    <section class="kit cf-vars">
      <header class="kit-head" data-reveal>
        <h2>Design system</h2>
        <p>The components the MVP is assembled from, rebuilt here in code.</p>
      </header>
      <div class="kit-grid cf">
        <article class="card span-6" data-reveal>
          <p class="label">Buttons</p>
          <div class="stack">
            <span class="cf-btn">Create Account</span>
            <span class="cf-btn is-navy">Next <Fragment set:html={svg('arrow')} /></span>
            <span class="cf-btn is-black">Sign up with Apple</span>
            <span class="cf-btn is-outline">Sign up with Google</span>
            <span class="cf-btn is-soft"><Fragment set:html={svg('mail')} /> Sign up with Email</span>
          </div>
          <p class="states"><span>Primary</span><span>Secondary</span><span>Provider</span><span>Outline</span><span>Soft</span></p>
        </article>

        <article class="card span-6" data-reveal>
          <p class="label">Inputs</p>
          <div class="stack">
            <span class="cf-field is-search"><Fragment set:html={svg('search', 20)} /> Search for a recipe</span>
            <span class="cf-field"><Fragment set:html={svg('mail', 20)} /> Email</span>
            <span class="cf-field">
              <Fragment set:html={svg('lock', 20)} />
              <b><small>Password</small>••••••••••</b>
            </span>
            <span class="cf-setting">Serving for: <span class="cf-stepper"><span set:html={svg('minus', 16)} /><span>1</span><span set:html={svg('plus', 16)} /></span></span>
            <span class="cf-setting">Time to cook: <span class="cf-stepper"><span set:html={svg('minus', 16)} /><span>10 min</span><span set:html={svg('plus', 16)} /></span></span>
          </div>
        </article>

        <article class="card span-6" data-reveal>
          <p class="label">Selection</p>
          <div class="cf-chips">
            <span class="cf-chip"><Fragment set:html={svg('check', 16)} /> Oven</span>
            <span class="cf-chip"><Fragment set:html={svg('check', 16)} /> Blender</span>
            <span class="cf-chip"><Fragment set:html={svg('check', 16)} /> Toaster</span>
            <span class="cf-chip is-off">Microwave</span>
            <span class="cf-chip is-off">Coffee maker</span>
          </div>
          <p class="states"><span>Checked</span><span>Unchecked</span></p>
          <p class="label gap">Cards</p>
          <div class="stack">
            <span class="cf-banner"><b>Confirm Ingredients</b><small>Update as needed.</small></span>
            <span class="cf-promo">
              <b>Tell what do you’ve got and let’s start cooking!</b>
              <span class="cf-btn is-small">Start <Fragment set:html={svg('arrow')} /></span>
            </span>
          </div>
        </article>

        <article class="card span-6" data-reveal>
          <p class="label">Lists</p>
          <div class="stack">
            <span class="cf-item"><i>1</i> Ditch the recipe hunt!</span>
            <span class="cf-item"><i>2</i> Cook with ingredients you have!</span>
            <span class="cf-item is-orange"><i>1</i> Enter your kitchen appliances and gear.</span>
            <span class="cf-row">Olive oil <span>1/4</span></span>
            <span class="cf-row">Milk <span>1 cup</span></span>
          </div>
          <p class="states"><span>Onboarding, green</span><span>Onboarding, orange</span><span>Ingredient</span></p>
        </article>

        <article class="card span-12" data-reveal>
          <p class="label">Navigation</p>
          <div class="nav">
            <div class="cf-tabs">
              <span class="cf-tab is-active"><span set:html={svg('home', 20)} />Home</span>
              <span class="cf-tab"><span set:html={svg('game', 20)} />Game</span>
              <span class="cf-tab"><span set:html={svg('book', 20)} />My Recipes</span>
              <span class="cf-tab is-fab"><span set:html={svg('pot', 22)} />Let’s Cook</span>
            </div>
            <span class="cf-back"><Fragment set:html={svg('back')} /> Back</span>
            <span class="cf-coin"><i>★</i> 1500</span>
          </div>
        </article>
      </div>
    </section>
  </ProjectSplit>

  <nav class="container next" aria-label="Next project">
    <p class="eyebrow">Next project</p>
    <a href={`/projects/${next.slug}`}>{next.title} <span aria-hidden="true">→</span></a>
  </nav>
</Base>

<style>
  h2 {
    font-size: var(--text-xl);
  }
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .shot {
    width: 100%;
  }

  /* Columna de texto */
  .side-title {
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-line);
    font-size: var(--text-base);
    letter-spacing: -0.01em;
  }
  .decisions {
    display: grid;
    gap: var(--space-4);
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
  }
  .decisions h3 {
    font-size: var(--text-sm);
    font-weight: var(--weight-strong);
    letter-spacing: 0;
  }
  .decisions p {
    margin-top: 2px;
    font-size: var(--text-xs);
    line-height: 1.5;
    color: var(--color-muted);
  }
  .facts {
    display: grid;
    gap: var(--space-3);
    margin: var(--space-8) 0 0;
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-line);
  }
  .facts div {
    display: grid;
    grid-template-columns: 6rem 1fr;
    gap: var(--space-3);
    font-size: var(--text-sm);
  }
  .facts dt {
    font-size: var(--text-2xs);
    letter-spacing: 0.08em;
    line-height: 1.9;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .facts dd {
    margin: 0;
  }

  /* Pantallas sobre el verde claro de la app */
  .stage {
    padding: var(--space-16) var(--space-8);
    background: var(--cf-sage);
  }
  .screens {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--space-16) var(--grid-gap);
  }

  /* Bloques de marca y design system */
  .kit {
    padding: var(--space-8);
    background: var(--cf-lime-soft);
  }
  .kit-head {
    margin-bottom: var(--space-8);
  }
  .kit-head p {
    max-width: 58ch;
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  .kit-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--space-4);
  }
  .card {
    grid-column: span 12;
    padding: var(--space-6);
    border-radius: 16px;
    background: var(--cf-white);
  }
  .span-7 {
    grid-column: span 7;
  }
  .span-6 {
    grid-column: span 6;
  }
  .span-5 {
    grid-column: span 5;
  }
  .label {
    margin-bottom: var(--space-4);
    font-family: var(--font-body);
    font-size: var(--text-2xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .label.gap {
    margin-top: var(--space-8);
  }
  .note {
    max-width: 44ch;
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  .stack {
    display: grid;
    gap: 10px;
  }
  .states {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    margin-top: var(--space-4) !important;
    font-family: var(--font-body);
    font-size: var(--text-2xs);
    color: var(--color-muted);
  }

  /* Marca */
  /* el logo va sobre navy, como en la pantalla de inicio de la app */
  .logo {
    display: grid;
    place-items: center;
    background: var(--cf-navy);
  }
  .logo img {
    width: min(100%, 15rem);
  }
  .naming .name {
    margin-bottom: var(--space-3);
    font-size: var(--text-2xl);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--cf-navy);
  }
  .naming .label:not(:first-child) {
    margin-top: var(--space-8);
  }
  .inter {
    margin-top: var(--space-3);
    font-size: var(--text-xl);
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  /* Paleta de Chefy: cuatro grupos de roles, cada uno una pila redondeada de cuatro colores */
  .roles {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-8) var(--space-6);
    font-family: 'Inter Variable', system-ui, sans-serif;
    color: var(--cf-ink);
  }
  .role-title {
    margin-bottom: var(--space-3);
    font-size: var(--text-base);
    font-weight: 500;
  }
  .role-stack {
    display: grid;
    margin: 0;
    padding: 0;
    overflow: hidden;
    border-radius: 12px;
    box-shadow: inset 0 0 0 1px var(--cf-line);
    list-style: none;
  }
  /* nombre a la izquierda y código a la derecha, en la misma línea */
  .role-stack li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: 3.5rem;
    padding: 12px 16px;
    font-size: var(--text-sm);
    font-weight: 500;
    line-height: 1.2;
  }
  .role-stack .tok {
    flex: none;
    font-variant-numeric: tabular-nums;
  }

  /* Navegación */
  .nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-8);
  }
  .nav .cf-tabs {
    flex: 0 1 22rem;
  }

  /* Next project: franja gris claro, para separarla del proyecto y del footer */
  .next {
    padding-block: var(--space-16);
    background: var(--gray-light);
  }
  .next a {
    display: inline-block;
    margin-top: var(--space-3);
    font-size: var(--text-2xl);
    font-weight: var(--weight-heading);
    line-height: var(--leading-tight);
    letter-spacing: -0.03em;
    text-decoration: none;
  }
  .next a:hover {
    background: var(--color-accent);
    color: var(--color-on-accent);
  }

  @media (max-width: 1080px) {
    .span-7,
    .span-6,
    .span-5 {
      grid-column: span 12;
    }
    .roles {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 860px) {
    .kit,
    .stage {
      padding-inline: var(--space-4);
    }
  }
</style>
