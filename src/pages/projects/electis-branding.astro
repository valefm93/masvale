---
// Proyecto de branding de Electis (separado del case study de producto).
// Logo, paleta y tipografía: versión final (Figma). El contexto de marca sale de la presentación original.
import '@fontsource/schibsted-grotesk/400.css';
import '@fontsource/schibsted-grotesk/500.css';
import '@fontsource/schibsted-grotesk/700.css';
import Base from '../../layouts/Base.astro';
import ProjectSplit from '../../components/ProjectSplit.astro';
import { projects } from '../../data/projects';
import logoRaw from '../../../public/images/electis-brand/logo-white.svg?raw';

// Logo animado (versión sobre azul). Orden de los trazos en el archivo:
// círculo 1, círculo 2, punto, círculo 3, círculo 4 y las 7 letras.
// Los cuatro círculos y el punto se agrupan en "mark" (el grupo que llega desde muy cerca, girando).
const parts = ['ring', 'ring', 'dot', 'ring', 'ring', ...Array(7).fill('letter')];
let step = 0;
const logoAnimated = logoRaw
  .replace('<svg ', '<svg role="img" aria-label="Electis logo on navy" ')
  .replace(/<path /g, () => {
    const k = step++;
    const open = k === 0 ? '<g class="mark">' : k === 5 ? '</g>' : '';
    // turno: los 3 círculos que acompañan (1, 2, 3) y las letras (0…6); el círculo del punto no lleva turno
    const turn = k >= 5 ? k - 5 : { 0: 1, 3: 2, 4: 3 }[k] ?? 0;
    return `${open}<path class="${parts[k]}${k === 1 ? ' is-lead' : ''}" style="--k:${turn}" `;
  });

const hierarchy = [
  { name: 'Display', spec: 'Bold · 56 / 60 · -2%', cls: 'h-display', sample: 'Le vote électronique, simplifié.' },
  { name: 'Heading', spec: 'Bold · 32 / 38 · -1%', cls: 'h-heading', sample: 'Votre élection, étape par étape' },
  { name: 'Subheading', spec: 'Medium · 20 / 28', cls: 'h-sub', sample: 'Un accompagnement du début à la fin' },
  {
    name: 'Body',
    spec: 'Regular · 16 / 24',
    cls: 'h-body',
    sample: 'On combine une technologie de pointe avec un vrai accompagnement : vous gardez le contrôle, on s’occupe de la complexité.',
  },
  { name: 'Caption', spec: 'Medium · 12 / 16 · +4%', cls: 'h-caption', sample: 'SCRUTIN OUVERT · 12 JOURS RESTANTS' },
];

const project = projects.find((p) => p.slug === 'electis-branding')!;
const next = projects[(projects.indexOf(project) + 1) % projects.length];

const facts = [
  { label: 'Scope', value: 'Logo · Color · Typography · Brand applications' },
  { label: 'Tools', value: 'Figma · Illustrator' },
];

const personality = [
  { title: 'Corporate and trustable', text: 'A personality organizations can rely on.' },
  { title: 'A solutions provider', text: 'Not only elections: any decision a group needs to make.' },
  { title: 'Verifiable transparency', text: 'Above all, anyone can check the result.' },
];
const keywords = ['Security', 'Transparency', 'Trust', 'Opinion', 'Technology', 'Democracy'];

const colors = [
  { name: 'Blue Whale', hex: '#052E66', cls: 'whale', light: true },
  { name: 'Royal Blue', hex: '#2143E7', cls: 'royal', light: true },
  { name: 'Sky Blue', hex: '#29ADFF', cls: 'sky', light: true },
  { name: 'Green Fluor', hex: '#AED600', cls: 'green' },
  { name: 'Light Orange', hex: '#FFBA18', cls: 'orange' },
];
const neutrals = ['#F7F7FF', '#E9ECFB', '#D5D8F7', '#132E65', '#0D2048', '#020518'];
---

<Base title="Electis branding" description={project.summary} image={project.cover}>
  <ProjectSplit project={project}>
    <Fragment slot="text">
      <p>
        The brand identity for Electis, an electronic voting platform that doesn’t just focus on elections: it gives
        groups of people trustable and protected data of their opinion.
      </p>
    </Fragment>
    <Fragment slot="extra">
      <dl class="facts">
        {
          facts.map((f) => (
            <div>
              <dt>{f.label}</dt>
              <dd>{f.value}</dd>
            </div>
          ))
        }
      </dl>

      <h2 class="side-title">Brand personality</h2>
      <ol class="decisions">
        {
          personality.map((m) => (
            <li>
              <h3>{m.title}</h3>
              <p>{m.text}</p>
            </li>
          ))
        }
      </ol>

      <h2 class="side-title">Key words</h2>
      <ul class="keywords">
        {keywords.map((k) => <li>{k}</li>)}
      </ul>
    </Fragment>

    <!-- Versiones del logo -->
    <section class="logos eb" data-reveal style="--reveal-i:1">
      <div class="logo-card is-navy" data-logo-anim set:html={logoAnimated} />
      <div class="logo-card is-white"><img src="/images/electis-brand/logo.svg" alt="Electis logo on white" /></div>
      <div class="logo-card is-sky"><img src="/images/electis-brand/logo-sky.svg" alt="Electis logo on sky blue" /></div>
    </section>

    <section class="chapter" data-reveal>
      <header>
        <p class="n">01</p>
        <h2>The logo</h2>
        <p>
          A minimal logo whose symbol is built from four circles: four radio buttons, one of them selected. It stands
          for a decision made, the digital version of a check mark. The lowercase wordmark keeps it accessible, modern
          and digital.
        </p>
      </header>
    </section>

    <!-- Color -->
    <section class="chapter" data-reveal>
      <header>
        <p class="n">02</p>
        <h2>Color palette</h2>
        <p>
          Blue is associated with trust and reliability, and green symbolizes transparency. The dark blue gives the
          brand its corporate image; the brighter accents add the friendly touch.
        </p>
      </header>
      <div class="palette eb">
        {
          colors.map((c) => (
            <div class:list={['swatch', c.cls, { light: c.light }]} style={`background:${c.hex}`}>
              <b>{c.name}</b>
              <span>{c.hex.slice(1)}</span>
            </div>
          ))
        }
        <div class="neutrals" aria-label="Neutral scale">
          {neutrals.map((n) => <span style={`background:${n}`} />)}
        </div>
      </div>
    </section>

    <!-- Tipografía -->
    <section class="chapter" data-reveal>
      <header>
        <p class="n">03</p>
        <h2>Typography</h2>
        <p>
          Schibsted Grotesk: a minimal sans serif with a geometric foundation, friendly and legible at every size.
        </p>
      </header>
      <div class="type eb">
        <p class="type-name">Font: Schibsted Grotesk</p>
        <p class="type-sample">Solution de vote en ligne vérifiée</p>
        <p class="type-weights"><span>Regular</span><span class="w5">Medium</span><span class="w7">Bold</span></p>
      </div>

      <!-- Jerarquía tipográfica -->
      <div class="scale eb">
        <p class="scale-title">Typeface hierarchy</p>
        {
          hierarchy.map((h) => (
            <div class="scale-row">
              <p class="scale-meta">
                <b>{h.name}</b>
                <span>{h.spec}</span>
              </p>
              <p class:list={['scale-sample', h.cls]}>{h.sample}</p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Aplicaciones -->
    <section class="chapter" data-reveal>
      <header>
        <p class="n">04</p>
        <h2>In use</h2>
        <p>The same system on the website and inside the product, on desktop and mobile.</p>
      </header>
      <div class="uses">
        <figure class="is-tall">
          <img src="/images/electis-brand/use-website.png" alt="The Electis website" loading="lazy" />
        </figure>
        <figure>
          <img src="/images/electis-brand/use-product.png" alt="The Electis product on desktop" loading="lazy" />
        </figure>
        <figure>
          <img src="/images/electis-brand/use-mobile.png" alt="The Electis product on mobile" loading="lazy" />
        </figure>
      </div>
    </section>
  </ProjectSplit>

  <nav class="container next" aria-label="Next project">
    <p class="eyebrow">Next project</p>
    <a href={`/projects/${next.slug}`}>{next.title} <span aria-hidden="true">→</span></a>
  </nav>
</Base>

<script>
  // El logo se anima cada vez que entra en pantalla; con un clic se repite
  const card = document.querySelector<HTMLElement>('[data-logo-anim]');
  if (card) {
    new IntersectionObserver(([e]) => card.classList.toggle('is-playing', e.isIntersecting), { threshold: 0.5 }).observe(card);
    card.addEventListener('click', () => {
      card.classList.remove('is-playing');
      void card.offsetWidth;
      card.classList.add('is-playing');
    });
  }
</script>

<style>
  /* Columna de texto */
  .facts {
    display: grid;
    gap: var(--space-3);
    margin: var(--space-8) 0 0;
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-line);
  }
  .facts div {
    display: grid;
    grid-template-columns: 6rem 1fr;
    gap: var(--space-3);
    font-size: var(--text-sm);
  }
  .facts dt {
    font-size: var(--text-2xs);
    letter-spacing: 0.08em;
    line-height: 1.9;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .facts dd {
    margin: 0;
  }
  .side-title {
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-line);
    font-size: var(--text-base);
    letter-spacing: -0.01em;
  }
  .decisions {
    display: grid;
    gap: var(--space-4);
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
  }
  .decisions h3 {
    font-size: var(--text-sm);
    font-weight: var(--weight-strong);
    letter-spacing: 0;
  }
  .decisions p {
    margin-top: 2px;
    font-size: var(--text-xs);
    line-height: 1.5;
    color: var(--color-muted);
  }

  .keywords {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
  }
  .keywords li {
    padding: 0.3em 0.8em;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    font-size: var(--text-xs);
  }

  /* Marca Electis: colores y tipografía de la versión final */
  .eb {
    --eb-whale: #052e66;
    --eb-ice: #f7f7ff;
    font-family: 'Schibsted Grotesk', system-ui, sans-serif;
    letter-spacing: 0;
  }

  /* Versiones del logo */
  .logos {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-2);
  }
  /* mismas esquinas y separación que la paleta de colores */
  .logo-card {
    display: grid;
    place-items: center;
    aspect-ratio: 3 / 2;
    border-radius: 12px;
  }
  .logo-card img {
    width: 56%;
  }
  /* La versión sobre azul es la principal: ocupa todo el ancho y el logo se arma solo */
  .logo-card.is-navy {
    grid-column: 1 / -1;
    aspect-ratio: 16 / 7;
    cursor: pointer;
  }
  .logo-card.is-navy :global(svg) {
    width: 44%;
    height: auto;
    overflow: visible;
  }
  /* Animación: la tarjeta arranca toda celeste, que resulta ser uno de los círculos visto muy de cerca.
     Ese círculo se aleja girando por una curva hasta su lugar, y los otros tres lo siguen por la misma
     curva, uno detrás de otro, siempre de grande a chico. Al final aparecen el punto y la palabra. */
  .logo-card.is-navy {
    overflow: hidden;
  }
  .logo-card :global(.ring) {
    /* todos giran y se achican alrededor del mismo punto: el centro del círculo que lleva el punto */
    transform-origin: 32.52px 10.84px;
  }
  .logo-card :global(.dot),
  .logo-card :global(.letter) {
    transform-box: fill-box;
    transform-origin: center;
  }
  .logo-card[data-logo-anim]:not(.is-playing) :global(.ring) {
    scale: 26;
    rotate: -220deg;
    translate: 50px -25px;
  }
  .logo-card[data-logo-anim]:not(.is-playing) :global(.dot),
  .logo-card[data-logo-anim]:not(.is-playing) :global(.letter) {
    opacity: 0;
  }
  .logo-card.is-playing :global(.ring) {
    --wait: calc(150ms + var(--k) * 190ms);
    animation:
      eb-zoom 2750ms var(--wait) both,
      eb-turn 2300ms cubic-bezier(0.3, 0, 0.2, 1) var(--wait) both,
      eb-path 2300ms cubic-bezier(0.45, 0, 0.3, 1) var(--wait) both;
  }
  .logo-card.is-playing :global(.dot) {
    animation: eb-dot 450ms cubic-bezier(0.3, 1.6, 0.5, 1) 3450ms both;
  }
  .logo-card.is-playing :global(.letter) {
    animation: eb-letter 500ms cubic-bezier(0.2, 0.8, 0.2, 1) calc(3650ms + var(--k) * 60ms) both;
  }
  /* Tamaño: baja de muy grande, se pasa apenas de su medida y vuelve una sola vez (un único rebote) */
  @keyframes eb-zoom {
    0% {
      scale: 26;
      /* sale rápido del celeste pleno y frena al llegar */
      animation-timing-function: cubic-bezier(0.2, 0.45, 0.2, 1);
    }
    80% {
      scale: 0.93;
      animation-timing-function: cubic-bezier(0.35, 0, 0.3, 1);
    }
    100% {
      scale: 1;
    }
  }
  @keyframes eb-turn {
    from {
      rotate: -220deg;
    }
  }
  @keyframes eb-path {
    from {
      translate: 50px -25px;
    }
  }
  @keyframes eb-dot {
    from {
      opacity: 0;
      scale: 0;
    }
  }
  @keyframes eb-letter {
    from {
      opacity: 0;
      translate: 0 8px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .logo-card[data-logo-anim] :global(*) {
      animation: none !important;
      scale: none !important;
      rotate: none !important;
      opacity: 1 !important;
    }
  }
  .logo-card.is-white {
    background: #fff;
    box-shadow: inset 0 0 0 1px var(--color-line);
  }
  .logo-card.is-navy {
    background: #052e66;
  }
  .logo-card.is-sky {
    background: #29adff;
  }

  /* Jerarquía tipográfica */
  .scale {
    padding: var(--space-8);
    border-radius: 12px;
    box-shadow: inset 0 0 0 1px var(--color-line);
    color: var(--eb-whale);
  }
  .scale-title {
    font-size: var(--text-sm);
    font-weight: 700;
  }
  .scale-row {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: var(--space-6);
    align-items: baseline;
    margin-top: var(--space-6);
    padding-top: var(--space-6);
    border-top: 1px solid #e9ecfb;
  }
  .scale-meta {
    display: grid;
    gap: 2px;
    font-size: var(--text-xs);
  }
  .scale-meta span {
    opacity: 0.65;
  }
  .h-display {
    font-size: 3.5rem;
    font-weight: 700;
    line-height: 1.07;
    letter-spacing: -0.02em;
  }
  .h-heading {
    font-size: 2rem;
    font-weight: 700;
    line-height: 1.19;
    letter-spacing: -0.01em;
  }
  .h-sub {
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.4;
  }
  .h-body {
    max-width: 52ch;
    font-size: 1rem;
    line-height: 1.5;
  }
  .h-caption {
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.33;
    letter-spacing: 0.04em;
  }

  /* Capítulos */
  .chapter {
    display: grid;
    gap: var(--grid-gap);
    padding-top: var(--space-12);
  }
  /* Capítulo: el número va arriba como etiqueta chica; título y texto, alineados al borde izquierdo de las imágenes */
  .chapter header {
    display: grid;
    gap: var(--space-2);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-line);
  }
  .n {
    font-size: var(--text-2xs);
    letter-spacing: 0.08em;
    color: var(--color-muted);
  }
  .chapter h2 {
    font-size: var(--text-xl);
  }
  .chapter header p:last-child {
    max-width: 58ch;
    margin-top: var(--space-1, 0.25rem);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  /* Paleta */
  .palette {
    display: grid;
    grid-template-columns: 1.4fr 1.4fr 1fr 3rem;
    grid-template-rows: 9rem 9rem;
    gap: var(--space-2);
  }
  .swatch {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: var(--space-4);
    border-radius: 12px;
    font-size: var(--text-sm);
    color: var(--eb-whale);
  }
  .swatch.light {
    color: #fff;
  }
  .swatch b {
    font-weight: 700;
  }
  .swatch span {
    font-size: var(--text-lg);
    font-weight: 500;
  }
  .whale {
    grid-row: span 2;
  }
  .neutrals {
    display: grid;
    grid-column: 4;
    grid-row: 1 / span 2;
    overflow: hidden;
    border-radius: 12px;
    box-shadow: inset 0 0 0 1px var(--color-line);
  }

  /* Tipografía */
  .type {
    padding: var(--space-8);
    border-radius: 12px;
    background: var(--eb-ice);
    color: var(--eb-whale);
  }
  .type-name {
    font-size: var(--text-sm);
    font-weight: 700;
  }
  .type-sample {
    max-width: 16ch;
    margin-top: var(--space-6);
    font-size: var(--text-2xl);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
  .type-weights {
    display: flex;
    gap: var(--space-6);
    margin-top: var(--space-8);
    font-size: var(--text-lg);
  }
  .w5 {
    font-weight: 500;
  }
  .w7 {
    font-weight: 700;
  }

  /* Aplicaciones */
  .uses {
    display: grid;
    grid-template-columns: 718fr 655fr;
    gap: var(--grid-gap);
    align-content: space-between;
    padding: var(--space-8);
    background: #f7f7ff;
  }
  .uses figure {
    margin: 0;
  }
  .uses .is-tall {
    grid-row: span 2;
  }
  .uses figure:last-child {
    align-self: end;
  }
  .uses img {
    display: block;
    width: 100%;
  }

  /* Next project: franja gris claro, para separarla del proyecto y del footer */
  .next {
    padding-block: var(--space-16);
    background: var(--gray-light);
  }
  .next a {
    display: inline-block;
    margin-top: var(--space-3);
    font-size: var(--text-2xl);
    font-weight: var(--weight-heading);
    line-height: var(--leading-tight);
    letter-spacing: -0.03em;
    text-decoration: none;
  }
  .next a:hover {
    background: var(--color-accent);
    color: var(--color-on-accent);
  }

  @media (max-width: 720px) {
    .scale-row {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }
    .h-display {
      font-size: 2.25rem;
    }
    .uses {
      grid-template-columns: 1fr;
      padding: var(--space-4);
    }
    .palette {
      grid-template-columns: 1fr 1fr 2.5rem;
      grid-template-rows: repeat(3, 7rem);
    }
    .neutrals {
      grid-column: 3;
      grid-row: 1 / span 3;
    }
  }
</style>
