---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ExperienceItem from '../components/ExperienceItem.astro';
import RichText from '../components/RichText.astro';
import { site } from '../data/site';
import { projects } from '../data/projects';
import { experience } from '../data/experience';
---

<Base>
  <!-- Hero -->
  <section class="hero container">
    <div class="hero-text">
      <p class="eyebrow">{site.greeting}</p>
      <h1>Product<br /><em>Designer</em></h1>
      <p class="intro">
        {site.intro.lead} <strong>{site.intro.highlight}</strong>{site.intro.rest}
      </p>
      <div class="actions">
        <a class="btn" href="/resume">My resume</a>
        <a class="btn ghost" href="#work">See my work</a>
      </div>
    </div>
    <div class="hero-media" aria-hidden="true">
      <img class="phone one" src={site.photos.hero[0]} alt="" />
      <img class="phone two" src={site.photos.hero[1]} alt="" />
    </div>
  </section>

  <!-- Featured projects -->
  <section id="work" class="section">
    <div class="container">
      <div class="section-head">
        <h2>Featured projects</h2>
        <p class="muted">Selected product work, from research to shipped interface.</p>
      </div>
      <div class="grid">
        {projects.map((p, i) => <ProjectCard project={p} index={i} />)}
      </div>
    </div>
  </section>

  <!-- About -->
  <section class="section about">
    <div class="container about-grid">
      <img class="portrait" src={site.photos.portrait} alt="Portrait of Vale Ferreira" loading="lazy" />
      <div>
        <h2>More about me</h2>
        <div class="about-text">
          {site.about.map((t) => <RichText text={t} />)}
        </div>
        <a class="btn" href="/resume">My resume</a>
      </div>
    </div>
  </section>

  <!-- Experience -->
  <section class="section">
    <div class="container split">
      <h2 class="sticky">Experience</h2>
      <ul class="list">
        {experience.map((item) => <ExperienceItem item={item} />)}
      </ul>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    align-items: center;
    gap: var(--space-12);
    min-height: calc(100svh - 64px);
    padding-block: var(--space-16);
  }
  h1 {
    margin-top: var(--space-4);
    font-size: var(--text-3xl);
  }
  h1 em {
    color: var(--color-accent);
  }
  .intro {
    margin-top: var(--space-8);
    max-width: 52ch;
    color: var(--color-muted);
  }
  .intro strong {
    color: var(--color-text);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }
  .hero-media {
    position: relative;
    aspect-ratio: 1 / 1;
  }
  .phone {
    position: absolute;
    width: 58%;
    filter: drop-shadow(0 30px 40px rgb(0 0 0 / 0.15));
  }
  .phone.one {
    left: 0;
    top: 0;
    transform: rotate(-6deg);
  }
  .phone.two {
    right: 0;
    bottom: 0;
    transform: rotate(5deg);
  }

  /* Buttons */
  .btn {
    display: inline-flex;
    align-items: center;
    padding: 0.85em 1.5em;
    border-radius: var(--radius-pill);
    background: var(--color-text);
    color: var(--color-bg);
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
    transition: background var(--duration) var(--ease);
  }
  .btn:hover {
    background: var(--color-accent);
  }
  .btn.ghost {
    background: transparent;
    color: var(--color-text);
    box-shadow: inset 0 0 0 1px var(--color-line);
  }
  .btn.ghost:hover {
    box-shadow: inset 0 0 0 1px var(--color-text);
  }

  /* Projects */
  .section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-12);
  }
  h2 {
    font-size: var(--text-2xl);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-12) var(--space-8);
  }

  /* About */
  .about {
    background: var(--color-surface);
  }
  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: var(--space-16);
    align-items: center;
  }
  .portrait {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-lg);
  }
  .about-text {
    display: grid;
    gap: var(--space-4);
    margin-block: var(--space-6) var(--space-8);
    color: var(--color-muted);
    max-width: 56ch;
  }

  /* Experience */
  .split {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: var(--space-12);
    align-items: start;
  }
  .sticky {
    position: sticky;
    top: 96px;
  }
  .list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 860px) {
    .hero,
    .about-grid,
    .split {
      grid-template-columns: 1fr;
    }
    .hero {
      min-height: auto;
    }
    .hero-media {
      max-width: 420px;
    }
    .grid {
      grid-template-columns: 1fr;
    }
    .sticky {
      position: static;
    }
  }
</style>
