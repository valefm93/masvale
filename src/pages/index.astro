---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import PortfolioTile from '../components/PortfolioTile.astro';
import RichText from '../components/RichText.astro';
import { site } from '../data/site';
import { projects } from '../data/projects';
---

<Base overlayHeader>
  <Hero />

  <!--
    Intro: ya está ubicada debajo del hero. Cuando el hero termina y sube,
    esta sección queda quieta y se va destapando (ver .under más abajo).
  -->
  <div class="under">
    <section class="under-pin">
      <div class="container intro">
        <p class="eyebrow">Hello!</p>
        <p class="statement">
          {site.intro.lead} <strong>{site.intro.highlight}</strong>{site.intro.rest}
        </p>
      </div>
    </section>
    <div class="under-space" aria-hidden="true"></div>
  </div>

  <!-- Featured projects -->
  <section id="work" class="section work">
    <div class="container">
      <div class="section-head" data-reveal>
        <h2>Featured projects</h2>
        <a class="all" href="/portfolio">View all work <span aria-hidden="true">→</span></a>
      </div>
      <div class="grid">
        {projects.filter((p) => p.featured).map((p, i) => <PortfolioTile project={p} index={i} />)}
      </div>
    </div>
  </section>

  <!-- About -->
  <section id="about" class="section about">
    <div class="container about-grid">
      <img class="portrait" src={site.photos.portrait} alt="Portrait of Vale Ferreira" loading="lazy" data-reveal />
      <div data-reveal style="--reveal-i:1">
        <h2>More about me</h2>
        <div class="about-text">
          {site.about.map((t) => <RichText text={t} />)}
        </div>
        <a class="btn" href="/resume">My resume</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Buttons */
  .btn {
    display: inline-flex;
    align-items: center;
    padding: 0.85em 1.5em;
    border-radius: var(--radius-pill);
    background: var(--color-text);
    color: var(--color-bg);
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
    transition: background var(--duration) var(--ease);
  }
  .btn:hover {
    background: var(--color-accent);
    color: var(--color-on-accent);
  }
  .btn.ghost {
    background: transparent;
    color: var(--color-text);
    box-shadow: inset 0 0 0 1px var(--color-line);
  }
  .btn.ghost:hover {
    box-shadow: inset 0 0 0 1px var(--color-text);
  }

  /*
    Efecto telón: .under empieza una pantalla antes (debajo del último tramo del hero)
    y su contenido queda fijo durante una pantalla de scroll, mientras el hero sube.
  */
  .under {
    position: relative;
    margin-top: -100svh;
  }
  .under-pin {
    position: sticky;
    top: 0;
    display: grid;
    align-items: center;
    min-height: 100svh;
    padding-block: var(--space-16);
    background: var(--color-bg);
  }
  .under-space {
    height: 100svh;
  }

  /* Intro */
  .intro {
    display: grid;
    grid-template-columns: var(--col-4) 1fr;
    gap: var(--grid-gap);
    align-items: start;
  }
  .intro .eyebrow {
    padding-top: 0.9em;
  }
  .statement {
    max-width: 30ch;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: 1.2;
    letter-spacing: -0.01em;
    text-wrap: pretty;
  }
  .statement strong {
    font-weight: 400;
    font-style: italic;
    background: linear-gradient(transparent 58%, var(--color-accent) 58% 92%, transparent 92%);
  }

  /* Projects */
  .work {
    padding-top: var(--space-8);
  }
  .section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: start;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-12);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-line);
  }
  h2 {
    font-size: var(--text-2xl);
  }
  .all {
    font-size: var(--text-sm);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
  }
  .all:hover {
    background: var(--color-accent);
    color: var(--color-on-accent);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--grid-gap);
  }

  /* About */
  .about {
    background: var(--color-surface);
  }
  .about-grid {
    display: grid;
    grid-template-columns: var(--col-6) 1fr;
    gap: var(--grid-gap);
    align-items: center;
  }
  .portrait {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }
  .about-text {
    display: grid;
    gap: var(--space-4);
    margin-block: var(--space-6) var(--space-8);
    color: var(--color-muted);
    max-width: 56ch;
  }

  @media (max-width: 860px) {
    .intro,
    .about-grid {
      grid-template-columns: 1fr;
    }
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
