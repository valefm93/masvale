---
import Base from '../layouts/Base.astro';
import HeroCovers from '../components/HeroCovers.astro';
import Karaoke from '../components/Karaoke.astro';
import PortfolioTile from '../components/PortfolioTile.astro';
import RichText from '../components/RichText.astro';
import { site } from '../data/site';
import { projects } from '../data/projects';

const { lead, highlight, rest } = site.intro;
const introParts = [{ text: `${lead} ` }, { text: highlight, mark: true }, { text: rest }];
// Por ahora la home es SOLO el hero. Cada una de estas secciones vuelve a mostrarse poniendo true.
const showIntro = false; // la frase "My passion…"
const showFeatured = false; // Featured projects
const showAbout = false; // "Designer first, product always"
const showFooter = false; // el footer de contacto
---

<Base overlayHeader hideFooter={!showFooter}>
  <HeroCovers contactHref={showFooter ? '#contact' : '/resume#contact'} />

  <!-- Frase de presentación (oculta con showIntro) -->
  {
    showIntro && (
      <>
        <div class="under" data-karaoke-track data-start="0.55" data-end-pad="1.25">
          <section class="under-pin">
            <div class="container intro">
              <Karaoke class="statement" parts={introParts} />
            </div>
          </section>
          <div class="under-space" aria-hidden="true"></div>
        </div>
      </>
    )
  }

  <!-- Featured projects (oculta con showFeatured) -->
  {
    showFeatured && (
      <>
        <section id="work" class="section work">
          <div class="container">
            <div class="section-head" data-reveal>
              <h2>Featured projects</h2>
              <a class="all" href="/portfolio">View all work <span aria-hidden="true">→</span></a>
            </div>
            <div class="grid">
              {projects.filter((p) => p.featured).map((p, i) => <PortfolioTile project={p} index={i} />)}
            </div>
          </div>
        </section>
      </>
    )
  }

  <!-- About ("Designer first, product always"): OCULTA por ahora. Para volver a mostrarla, cambiar showAbout a true (arriba). -->
  {
    showAbout && (
      <section id="about" class="section about">
        <div class="container about-grid">
          <img class="portrait" src={site.photos.portrait} alt="Design process boards: notes, areas for improvement and user flows" loading="lazy" data-reveal />
          <div data-reveal style="--reveal-i:1">
            <h2>{site.aboutTitle}</h2>
            <div class="about-text">
              {site.about.map((t) => <RichText text={t} />)}
            </div>
            <a class="btn" href="/resume">About me</a>
          </div>
        </div>
      </section>
    )
  }
</Base>

<style>
  /* Botón: mismo estilo que los del menú y el hero (mayúsculas, borde redondeado) */
  .btn {
    display: inline-flex;
    align-items: center;
    padding: 0.75em 1.5em;
    border: 1px solid currentColor;
    border-radius: var(--radius-pill);
    font-size: var(--text-xs);
    line-height: 1;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    text-decoration: none;
    transition:
      background var(--duration) var(--ease),
      border-color var(--duration) var(--ease),
      color var(--duration) var(--ease);
  }
  .btn:hover {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-on-accent);
  }

  /*
    Efecto telón: .under empieza una pantalla antes (debajo del último tramo del hero)
    y su contenido queda fijo durante una pantalla de scroll, mientras el hero sube.
  */
  .under {
    position: relative;
    margin-top: -100svh;
  }
  .under-pin {
    position: sticky;
    top: 0;
    display: grid;
    align-items: center;
    min-height: 100svh;
    padding-block: var(--space-16);
    background: var(--color-bg);
  }
  /* una pantalla para el telón + el tramo en que el texto se va iluminando */
  .under-space {
    height: 230svh;
  }

  /* Intro */
  /* Presentación: centrada en la grilla, como la frase de About me */
  .statement {
    max-width: 36ch;
    margin-inline: auto;
    font-family: var(--font-body);
    font-size: var(--text-xl);
    line-height: 1.2;
    letter-spacing: -0.02em;
    text-align: center;
    text-wrap: balance;
  }

  /* Projects */
  .work {
    padding-top: var(--space-8);
  }
  .section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: start;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-12);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-line);
  }
  h2 {
    font-size: var(--text-2xl);
  }
  .all {
    font-size: var(--text-sm);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
  }
  .all:hover {
    background: var(--color-accent);
    color: var(--color-on-accent);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--grid-gap);
  }

  /* About */
  .about {
    background: var(--color-surface);
  }
  .about-grid {
    display: grid;
    grid-template-columns: var(--col-6) 1fr;
    gap: var(--grid-gap);
    align-items: center;
  }
  .portrait {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .about-text {
    display: grid;
    gap: var(--space-4);
    margin-block: var(--space-6) var(--space-8);
    color: var(--color-muted);
    max-width: 56ch;
  }

  @media (max-width: 860px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
