---
import Base from '../layouts/Base.astro';
import ExperienceItem from '../components/ExperienceItem.astro';
import Pill from '../components/Pill.astro';
import { site, skills, software, links } from '../data/site';
import { experience, education } from '../data/experience';
---

<Base title="Resume" description="Experience, skills and education of Vale Ferreira, Product Designer.">
  <section class="container head">
    <img class="photo" src={site.photos.resume} alt="Vale Ferreira" />
    <div>
      <p class="eyebrow">Resume</p>
      <h1>{site.name}</h1>
      <p class="lead">{site.resumeIntro}</p>
    </div>
  </section>

  <section class="container block">
    <h2>Experience</h2>
    <ul class="list">
      {experience.map((item) => <ExperienceItem item={item} showLogo={false} />)}
    </ul>
  </section>

  <section class="container block">
    <h2>Skills</h2>
    <div class="pills">
      {skills.map((s) => <Pill>{s}</Pill>)}
    </div>
  </section>

  <section class="container block">
    <h2>Software</h2>
    <ul class="software">
      {
        software.map((s) => (
          <li>
            <img src={s.icon} alt="" width="40" height="40" loading="lazy" />
            <span>{s.name}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="container block">
    <h2>Education</h2>
    <ul class="list">
      {
        education.map((e) => (
          <li class="edu">
            <p class="meta">
              {e.place} · {e.year}
            </p>
            <h3>{e.title}</h3>
            <p class="muted">{e.description}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="container block">
    <h2>More</h2>
    <ul class="list">
      {
        links.map((l) => (
          <li class="edu">
            <h3>
              <a href={l.href} target="_blank" rel="noopener">
                {l.label} <span aria-hidden="true">↗</span>
              </a>
            </h3>
            <p class="muted">{l.description}</p>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  .head {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-8);
    align-items: center;
    padding-block: var(--space-24) var(--space-16);
  }
  .photo {
    width: 140px;
    height: 140px;
    border-radius: 50%;
    object-fit: cover;
  }
  h1 {
    margin-top: var(--space-2);
    font-size: var(--text-2xl);
  }
  .lead {
    margin-top: var(--space-4);
    max-width: 56ch;
    color: var(--color-muted);
  }
  .block {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: var(--space-12);
    padding-block: var(--space-12);
    border-top: 1px solid var(--color-line);
  }
  h2 {
    font-size: var(--text-xl);
  }
  .list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .list > :global(li:first-child) {
    border-top: 0;
    padding-top: 0;
  }
  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .software {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .software li {
    display: grid;
    justify-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--color-muted);
  }
  .edu {
    padding-block: var(--space-6);
    border-top: 1px solid var(--color-line);
  }
  .edu h3 {
    margin-block: var(--space-2);
    font-size: var(--text-lg);
    font-family: var(--font-body);
    font-weight: 500;
  }
  .edu a {
    text-decoration: none;
  }
  .edu a:hover {
    color: var(--color-accent);
  }
  .meta {
    font-size: var(--text-xs);
    color: var(--color-muted);
  }
  .muted {
    font-size: var(--text-sm);
  }

  @media (max-width: 760px) {
    .head,
    .block {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
  }
</style>
