---
// Galería con todos los trabajos. Los que tienen `featured: true` también salen en la home.
import Base from '../layouts/Base.astro';
import PortfolioTile from '../components/PortfolioTile.astro';
import { projects, categories, upcoming } from '../data/projects';
import { portfolioNote } from '../data/site';

// Filtros: las categorías de projects.ts que tengan al menos un proyecto
const tags = categories.filter((c) => projects.some((p) => p.categories.includes(c)));
const pad = (n: number) => String(n).padStart(2, '0');
---

<Base title="Projects" description="Product design work by Vale Ferreira.">
  <section class="container page">
    <header class="head" data-reveal>
      <div class="title" data-typewriter="auto" data-text={portfolioNote}>
        <h1 aria-describedby="portfolio-note">Projects</h1>
        <p class="visually-hidden" id="portfolio-note">{portfolioNote}</p>
        <p class="msg type-msg" aria-hidden="true">
          <span data-typed></span><span class="type-caret"></span>
        </p>
      </div>
      <div class="filters" role="group" aria-label="Filter by type of work" data-filters>
        <button type="button" data-filter="" aria-pressed="true">All</button>
        {
          tags.map((t) => (
            <button type="button" data-filter={t} aria-pressed="false">
              {t}
            </button>
          ))
        }
      </div>
      <p class="count" aria-live="polite"><span data-count>{pad(projects.length)}</span> projects</p>
    </header>
    <div class="grid">
      {projects.map((p, i) => <PortfolioTile project={p} index={i} />)}
      {
        upcoming.map((u, i) => (
          <div class="soon" data-soon tabindex="0" data-reveal style={`--reveal-i:${(projects.length + i) % 2}`}>
            <img src={u.cover} alt="" loading="lazy" />
            <span class="soon-info">
              <span class="soon-tag">Coming soon</span>
              <span class="soon-client">{u.client}</span>
              <span class="soon-name">{u.title}</span>
            </span>
          </div>
        ))
      }
    </div>
  </section>
</Base>

<style>
  /*
    Cabecera compacta: título, filtros y contador en una sola fila,
    para que entren al menos dos filas de proyectos en la pantalla.
  */
  .page {
    padding-block: var(--space-6) var(--space-section);
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-8);
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-line);
  }
  h1 {
    font-size: var(--text-xl);
  }
  .count {
    margin-left: auto;
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  /* Mensaje que se escribe solo al pasar el mouse por el título: cae debajo, sobre la grilla */
  .title {
    position: relative;
  }
  .msg {
    position: absolute;
    top: calc(100% + var(--space-3));
    left: 0;
    z-index: 5;
    width: min(19rem, 80vw);
    border-top-left-radius: var(--radius-tail); /* sale del título, que está arriba */
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .filters button {
    padding: 0.7em 1.3em;
    border: 1px solid var(--color-text);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--color-text);
    font: inherit;
    font-size: var(--text-2xs);
    line-height: 1;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      background var(--duration) var(--ease),
      border-color var(--duration) var(--ease),
      color var(--duration) var(--ease);
  }
  .filters button:hover {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-on-accent);
  }
  .filters button[aria-pressed='true'] {
    background: var(--color-text);
    border-color: var(--color-text);
    color: var(--color-bg);
  }
  /* Tres por fila en escritorio: caben dos filas completas a la vista */
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--grid-gap);
  }
  .grid :global(.name),
  .grid .soon-name {
    font-size: var(--text-lg);
  }
  .grid :global(.info),
  .grid .soon-info {
    padding: var(--space-6);
  }
  .grid .soon-tag {
    top: var(--space-6);
    left: var(--space-6);
  }
  @media (max-width: 1100px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  /* Proyectos que vienen: se ven como los demás (portada), pero sin enlace;
     al pasar el mouse aparece "Coming soon" sobre el lima. */
  .soon {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--color-line);
    cursor: default;
  }
  .soon[hidden] {
    display: none;
  }
  .soon img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: scale 900ms var(--ease);
  }
  .soon-info {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: var(--space-2);
    padding: var(--space-8);
    background: var(--color-accent);
    color: var(--color-on-accent);
    opacity: 0;
    transition: opacity var(--duration) var(--ease);
  }
  .soon-tag {
    position: absolute;
    top: var(--space-8);
    left: var(--space-8);
    padding: 0.5em 1em;
    border: 1px solid currentColor;
    border-radius: var(--radius-pill);
    font-size: var(--text-2xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .soon-client {
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .soon-name {
    font-size: var(--text-xl);
    line-height: var(--leading-tight);
    letter-spacing: -0.03em;
  }
  .soon:hover .soon-info,
  .soon:focus-visible .soon-info {
    opacity: 1;
  }
  .soon:hover img,
  .soon:focus-visible img {
    scale: 1.04;
  }
  .soon:focus-visible {
    outline-offset: -4px;
    outline-color: var(--color-text);
  }
  /* En pantallas táctiles no hay hover: la etiqueta y el nombre quedan siempre visibles */
  @media (hover: none) {
    .soon-info {
      inset: auto 0 0 0;
      padding: var(--space-3) var(--space-4);
      opacity: 1;
    }
    .soon-tag {
      position: static;
      align-self: flex-start;
    }
    .soon-name {
      font-size: var(--text-lg);
    }
  }
  @media (max-width: 860px) {
    /* Sin espacio al costado: el mensaje va debajo del título */
    .msg {
      position: static;
      border-bottom-left-radius: var(--radius-bubble);
      border-top-left-radius: var(--radius-tail);
      width: auto;
      max-width: 22rem;
      min-height: 5.6em;
      margin-top: var(--space-4);
    }
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const filters = document.querySelector<HTMLElement>('[data-filters]');
  const tiles = [...document.querySelectorAll<HTMLElement>('[data-tile]')];
  const count = document.querySelector<HTMLElement>('[data-count]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  filters?.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('button[data-filter]');
    if (!button) return;
    const tag = button.dataset.filter ?? '';

    for (const b of filters.querySelectorAll('button')) b.setAttribute('aria-pressed', String(b === button));

    let visible = 0;
    for (const tile of tiles) {
      const show = !tag || (tile.dataset.tags ?? '').split('|').includes(tag);
      tile.hidden = !show;
      if (!show) continue;
      // Pequeña entrada escalonada de los proyectos que quedan
      if (!reduce) {
        tile.animate(
          [
            { opacity: 0, transform: 'translateY(12px)' },
            { opacity: 1, transform: 'none' },
          ],
          { duration: 450, delay: visible * 60, easing: 'cubic-bezier(0.22, 1, 0.36, 1)', fill: 'backwards' },
        );
      }
      visible++;
    }
    // los "Coming soon" no tienen categoría: solo se ven en "All"
    for (const s of document.querySelectorAll<HTMLElement>('[data-soon]')) s.hidden = !!tag;
    if (count) count.textContent = String(visible).padStart(2, '0');
  });
</script>
