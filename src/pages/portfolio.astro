---
// Galería con todos los trabajos. Los que tienen `featured: true` también salen en la home.
import Base from '../layouts/Base.astro';
import PortfolioTile from '../components/PortfolioTile.astro';
import { projects, categories, upcoming } from '../data/projects';
import { portfolioNote } from '../data/site';

// Filtros: las categorías de projects.ts que tengan al menos un proyecto
const tags = categories.filter((c) => projects.some((p) => p.categories.includes(c)));
const pad = (n: number) => String(n).padStart(2, '0');

// Grilla irregular (12 columnas): cada destacado ocupa 8 columnas y dos filas, con dos proyectos
// apilados al lado; el segundo bloque va en espejo. Los "Coming soon" van al final, más chicos.
const featured = projects.filter((p) => p.featured);
const general = projects.filter((p) => !p.featured);
const layout: { project: (typeof projects)[number]; place: string; fill: boolean }[] = [];
featured.forEach((p, k) => {
  const row = 1 + k * 2;
  const right = k % 2 === 1;
  layout.push({ project: p, place: `grid-column:${right ? 5 : 1} / span 8;grid-row:${row} / span 2`, fill: false });
  general.slice(k * 2, k * 2 + 2).forEach((g, j) =>
    layout.push({ project: g, place: `grid-column:${right ? 1 : 9} / span 4;grid-row:${row + j}`, fill: true }),
  );
});
// los generales que sobren (si hay más de dos por destacado) siguen en tamaño normal
general.slice(featured.length * 2).forEach((g) => layout.push({ project: g, place: '', fill: false }));
---

<Base title="Projects" description="Product design work by Vale Ferreira.">
  <section class="container page">
    <header class="head" data-reveal>
      <div class="title" data-typewriter="auto" data-text={portfolioNote}>
        <h1 aria-describedby="portfolio-note">Projects</h1>
        <p class="visually-hidden" id="portfolio-note">{portfolioNote}</p>
        <p class="msg type-msg" aria-hidden="true">
          <span data-typed></span><span class="type-caret"></span>
        </p>
      </div>
      <div class="filters" role="group" aria-label="Filter by type of work" data-filters>
        <button type="button" data-filter="" aria-pressed="true">All</button>
        {
          tags.map((t) => (
            <button type="button" data-filter={t} aria-pressed="false">
              {t}
            </button>
          ))
        }
      </div>
      <p class="count" aria-live="polite"><span data-count>{pad(projects.length)}</span> projects</p>
    </header>
    <div class="grid">
      {layout.map((l, i) => <PortfolioTile project={l.project} index={i} stagger={i} place={l.place} fill={l.fill} />)}
      <p class="soon-label" data-soon>Coming soon</p>
      {
        upcoming.map((u, i) => (
          <div class="soon" data-soon tabindex="0" data-reveal style={`--reveal-i:${i}`}>
            <img src={u.cover} alt="" loading="lazy" />
            <span class="soon-info">
              <span class="soon-tag">Coming soon</span>
              <span class="soon-client">{u.client}</span>
              <span class="soon-name">{u.title}</span>
            </span>
          </div>
        ))
      }
    </div>
  </section>
</Base>

<style>
  /*
    Cabecera compacta: título, filtros y contador en una sola fila,
    para que entren al menos dos filas de proyectos en la pantalla.
  */
  .page {
    padding-block: var(--space-6) var(--space-section);
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-8);
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-line);
  }
  h1 {
    font-size: var(--text-xl);
  }
  .count {
    margin-left: auto;
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  /* Mensaje que se escribe solo al pasar el mouse por el título: cae debajo, sobre la grilla */
  .title {
    position: relative;
  }
  .msg {
    position: absolute;
    top: calc(100% + var(--space-3));
    left: 0;
    z-index: 5;
    width: min(19rem, 80vw);
    border-top-left-radius: var(--radius-tail); /* sale del título, que está arriba */
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .filters button {
    padding: 0.7em 1.3em;
    border: 1px solid var(--color-text);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--color-text);
    font: inherit;
    font-size: var(--text-2xs);
    line-height: 1;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      background var(--duration) var(--ease),
      border-color var(--duration) var(--ease),
      color var(--duration) var(--ease);
  }
  .filters button:hover {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-on-accent);
  }
  .filters button[aria-pressed='true'] {
    background: var(--color-text);
    border-color: var(--color-text);
    color: var(--color-bg);
  }
  /* Grilla irregular de 12 columnas: destacados grandes, generales normales, "Coming soon" chicos.
     Las posiciones de cada proyecto se calculan arriba (layout). Con un filtro activo vuelve a ser pareja. */
  .grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--grid-gap);
  }
  .grid :global(.tile) {
    grid-column: span 4;
  }
  /* Esquinas levemente redondeadas en las cards de proyectos (prueba) */
  .grid :global(.tile),
  .grid .soon {
    border-radius: 12px;
  }
  .grid .soon {
    grid-column: span 3;
  }
  .soon-label {
    grid-column: 1 / -1;
    margin-top: var(--space-8);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-line);
    font-size: var(--text-2xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .soon-label[hidden] {
    display: none;
  }
  .grid .soon .soon-name {
    font-size: var(--text-base);
  }
  .grid .soon .soon-info {
    padding: var(--space-4);
  }
  .grid .soon .soon-tag {
    top: var(--space-4);
    left: var(--space-4);
  }
  /* Con un filtro activo: todos iguales, tres por fila */
  .grid.is-filtered :global(.tile) {
    grid-column: span 4 !important;
    grid-row: auto !important;
  }
  .grid :global(.name),
  .grid .soon-name {
    font-size: var(--text-lg);
  }
  .grid :global(.info),
  .grid .soon-info {
    padding: var(--space-6);
  }
  .grid .soon-tag {
    top: var(--space-6);
    left: var(--space-6);
  }
  /* Tablet: dos columnas parejas; los destacados ocupan el ancho completo */
  @media (max-width: 1100px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .grid :global(.tile),
    .grid.is-filtered :global(.tile) {
      grid-column: auto !important;
      grid-row: auto !important;
    }
    .grid :global(.tile.is-big) {
      grid-column: 1 / -1 !important;
    }
    .grid :global(.tile.is-fill) {
      aspect-ratio: 4 / 3;
    }
    .grid .soon {
      grid-column: auto;
    }
  }
  /* Tilt 3D con brillo (ver el script): inclinación hacia el cursor + reflejo que lo sigue */
  .grid :global(.has-tilt) {
    transform: perspective(1000px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    will-change: transform;
  }

  /* Entrada de las cards: suben, se aclaran y crecen apenas, una tras otra en el orden de la grilla.
     (Se declaran juntas con la transición del tilt para que una no pise a la otra.) */
  :global(.js) .grid :global([data-reveal]) {
    opacity: 0;
    translate: 0 2.5rem;
    scale: 0.96;
    transition:
      transform 500ms var(--ease),
      opacity 800ms var(--ease),
      translate 900ms var(--ease),
      scale 900ms var(--ease);
    transition-delay: 0s, var(--d), var(--d), var(--d);
    --d: calc(var(--reveal-i, 0) * 110ms);
  }
  :global(.js) .grid :global([data-reveal].is-visible) {
    opacity: 1;
    translate: none;
    scale: none;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .grid :global([data-reveal]) {
      opacity: 1;
      translate: none;
      scale: none;
    }
  }
  :global(.js) .grid :global([data-reveal].is-tilting) {
    transition-duration: 120ms, 800ms, 900ms, 900ms;
    transition-timing-function: linear, var(--ease), var(--ease), var(--ease);
  }
  .grid :global(.glare) {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: radial-gradient(
      circle at var(--gx, 50%) var(--gy, 50%),
      rgb(255 255 255 / 0.32),
      rgb(255 255 255 / 0.08) 35%,
      transparent 60%
    );
    mix-blend-mode: soft-light;
    opacity: 0;
    pointer-events: none;
    transition: opacity 400ms var(--ease);
  }
  .grid :global(.is-tilting .glare) {
    opacity: 1;
  }
  /* Proyectos que vienen: se ven como los demás (portada), pero sin enlace;
     al pasar el mouse aparece "Coming soon" sobre el lima. */
  .soon {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--color-line);
    cursor: default;
  }
  .soon[hidden] {
    display: none;
  }
  .soon img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: scale 900ms var(--ease);
  }
  .soon-info {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: var(--space-2);
    padding: var(--space-8);
    /* lima al 80 %: se alcanza a ver la portada debajo */
    background: color-mix(in srgb, var(--color-accent) 80%, transparent);
    color: var(--color-on-accent);
    opacity: 0;
    transition: opacity var(--duration) var(--ease);
  }
  .soon-tag {
    position: absolute;
    top: var(--space-8);
    left: var(--space-8);
    padding: 0.5em 1em;
    border: 1px solid currentColor;
    border-radius: var(--radius-pill);
    font-size: var(--text-2xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .soon-client {
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .soon-name {
    font-size: var(--text-xl);
    line-height: var(--leading-tight);
    letter-spacing: -0.03em;
  }
  .soon:hover .soon-info,
  .soon:focus-visible .soon-info {
    opacity: 1;
  }
  .soon:hover img,
  .soon:focus-visible img {
    scale: 1.04;
  }
  .soon:focus-visible {
    outline-offset: -4px;
    outline-color: var(--color-text);
  }
  /* En pantallas táctiles no hay hover: la etiqueta y el nombre quedan siempre visibles */
  @media (hover: none) {
    .soon-info {
      inset: auto 0 0 0;
      padding: var(--space-3) var(--space-4);
      opacity: 1;
    }
    .soon-tag {
      position: static;
      align-self: flex-start;
    }
    .soon-name {
      font-size: var(--text-lg);
    }
  }
  @media (max-width: 860px) {
    /* Sin espacio al costado: el mensaje va debajo del título */
    .msg {
      position: static;
      border-bottom-left-radius: var(--radius-bubble);
      border-top-left-radius: var(--radius-tail);
      width: auto;
      max-width: 22rem;
      min-height: 5.6em;
      margin-top: var(--space-4);
    }
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Tilt 3D con brillo: la tarjeta se inclina hacia el cursor y un reflejo suave lo sigue.
  // Solo con mouse (no en pantallas táctiles) y sin "reducir movimiento".
  if (window.matchMedia('(hover: hover) and (pointer: fine)').matches && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const MAX = 7; // grados de inclinación máxima
    for (const card of document.querySelectorAll<HTMLElement>('[data-tile], .soon')) {
      const glare = document.createElement('span');
      glare.className = 'glare';
      glare.setAttribute('aria-hidden', 'true');
      card.append(glare);
      card.classList.add('has-tilt');
      card.addEventListener('pointermove', (e) => {
        const r = card.getBoundingClientRect();
        const x = (e.clientX - r.left) / r.width;
        const y = (e.clientY - r.top) / r.height;
        card.style.setProperty('--rx', `${((0.5 - y) * MAX * 2).toFixed(2)}deg`);
        card.style.setProperty('--ry', `${((x - 0.5) * MAX * 2).toFixed(2)}deg`);
        card.style.setProperty('--gx', `${(x * 100).toFixed(1)}%`);
        card.style.setProperty('--gy', `${(y * 100).toFixed(1)}%`);
        card.classList.add('is-tilting');
      });
      card.addEventListener('pointerleave', () => {
        card.classList.remove('is-tilting');
        card.style.setProperty('--rx', '0deg');
        card.style.setProperty('--ry', '0deg');
      });
    }
  }

  const filters = document.querySelector<HTMLElement>('[data-filters]');
  const tiles = [...document.querySelectorAll<HTMLElement>('[data-tile]')];
  const count = document.querySelector<HTMLElement>('[data-count]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  filters?.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('button[data-filter]');
    if (!button) return;
    const tag = button.dataset.filter ?? '';

    for (const b of filters.querySelectorAll('button')) b.setAttribute('aria-pressed', String(b === button));

    let visible = 0;
    for (const tile of tiles) {
      const show = !tag || (tile.dataset.tags ?? '').split('|').includes(tag);
      tile.hidden = !show;
      if (!show) continue;
      // Pequeña entrada escalonada de los proyectos que quedan
      if (!reduce) {
        tile.animate(
          [
            { opacity: 0, transform: 'translateY(12px)' },
            { opacity: 1, transform: 'none' },
          ],
          { duration: 450, delay: visible * 60, easing: 'cubic-bezier(0.22, 1, 0.36, 1)', fill: 'backwards' },
        );
      }
      visible++;
    }
    // los "Coming soon" no tienen categoría: solo se ven en "All"
    for (const s of document.querySelectorAll<HTMLElement>('[data-soon]')) s.hidden = !!tag;
    // con un filtro activo la grilla irregular pasa a ser pareja (si no, quedarían huecos)
    document.querySelector('.grid')?.classList.toggle('is-filtered', !!tag);
    if (count) count.textContent = String(visible).padStart(2, '0');
  });
</script>
