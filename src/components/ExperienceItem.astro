---
// Una entrada de la línea de tiempo del Resume: cargo, descripción y datos del trabajo.
import type { Experience } from '../data/experience';

interface Props {
  item: Experience;
}
const { item } = Astro.props;
const year = item.period.split('/')[0].trim();
const facts = [
  { label: 'Company', value: item.company },
  { label: 'Period', value: item.period },
  { label: 'Location', value: item.location },
];
---

<li class="item" data-year={year}>
  <p class="year" aria-hidden="true">{year}</p>
  {item.logo && <img class="logo" src={item.logo} alt="" width="112" height="112" loading="lazy" />}
  <h3 class="role" data-reveal>{item.role}</h3>
  <p class="desc" data-reveal style="--reveal-i:1">{item.description}</p>
  <dl class="facts" data-reveal style="--reveal-i:2">
    {
      facts.map((f) => (
        <div>
          <dd>{f.value}</dd>
          <dt>{f.label}</dt>
        </div>
      ))
    }
  </dl>
</li>

<style>
  .item {
    position: relative;
    padding-block: var(--space-16);
  }
  /* En desktop el año grande vive en la columna izquierda (ver resume.astro) */
  .year {
    display: none;
    margin-bottom: var(--space-4);
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-3xl);
    line-height: 1;
  }
  /*
    Logo: entra grande e inclinado sobre el título y, con el scroll, baja hasta
    quedar derecho junto a la línea. --t (0 a 1) lo escribe el script de resume.astro.
  */
  .logo {
    --rest: calc(1 - var(--t, 1));
    position: absolute;
    right: calc(100% + var(--space-4) + var(--space-4));
    bottom: var(--space-16);
    z-index: 1;
    width: clamp(4.5rem, 7.5vw, 7rem);
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    transform-origin: right bottom;
    translate: calc(var(--rest) * 45%) calc(var(--rest) * -130%);
    scale: calc(1 + var(--rest) * 1.3);
    rotate: calc(var(--rest) * -9deg);
  }
  .item:nth-child(even) .logo {
    rotate: calc(var(--rest) * 7deg);
  }
  .role {
    max-width: 18ch;
    font-size: var(--text-xl);
    text-wrap: balance;
  }
  .desc {
    margin-top: var(--space-6);
    max-width: 62ch;
    font-size: var(--text-sm);
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
    margin: var(--space-8) 0 0;
    padding-block: var(--space-4);
    border-block: 1px solid var(--color-line);
  }
  .facts div {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  dd {
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.3;
  }
  dt {
    order: -1;
    font-size: var(--text-2xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  @media (max-width: 860px) {
    .item {
      padding-block: var(--space-12);
    }
    .year {
      display: block;
    }
    .logo {
      position: static;
      margin-bottom: var(--space-6);
      width: 5rem;
      translate: none;
      scale: none;
      rotate: none;
    }
    .item:nth-child(even) .logo {
      rotate: none;
    }
  }
</style>
