---
// Pieza de la galería /portfolio: solo la portada; el nombre y la empresa aparecen al pasar el mouse.
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  index?: number;
}
const { project, index = 0 } = Astro.props;
---

<a class="tile" href={`/projects/${project.slug}`} data-tile
  data-tags={project.categories.join('|')}
  data-reveal
  style={`--reveal-i:${index % 2}`}
>
  <img src={project.cover} alt="" loading="lazy" />
  <span class="info">
    <span class="client">{project.client}</span>
    <span class="name">{project.title}</span>
  </span>
</a>

<style>
  .tile[hidden] {
    display: none;
  }
  .tile {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--color-line);
    color: var(--white);
    text-decoration: none;
    cursor: var(--cursor-arrow);
  }
  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: scale 900ms var(--ease);
  }
  .info {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: var(--space-2);
    padding: var(--space-8);
    background: var(--color-accent);
    color: var(--color-on-accent);
    opacity: 0;
    transition: opacity var(--duration) var(--ease);
  }
  .client {
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .name {
    font-size: var(--text-xl);
    font-weight: 400;
    line-height: var(--leading-tight);
    letter-spacing: -0.03em;
  }
  .tile:hover .info,
  .tile:focus-visible .info {
    opacity: 1;
  }
  .tile:hover img,
  .tile:focus-visible img {
    scale: 1.04;
  }
  .tile:focus-visible {
    outline-offset: -4px;
    outline-color: var(--color-text);
  }

  /* En pantallas táctiles no hay hover: el nombre queda siempre visible abajo */
  @media (hover: none) {
    .info {
      inset: auto 0 0 0;
      padding: var(--space-3) var(--space-4);
      opacity: 1;
    }
    .name {
      font-size: var(--text-lg);
    }
  }
</style>
