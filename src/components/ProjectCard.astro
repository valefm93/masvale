---
import type { Project } from '../data/projects';
import Pill from './Pill.astro';

interface Props {
  project: Project;
  index: number;
}
const { project, index } = Astro.props;
---

<article class="card">
  <a href={`/projects/${project.slug}`} class="link">
    <div class="media">
      <img src={project.cover} alt="" loading="lazy" />
    </div>
    <div class="body">
      <p class="eyebrow">{String(index + 1).padStart(2, '0')} — {project.client}</p>
      <h3>{project.title}</h3>
      <p class="summary">{project.summary}</p>
      <div class="tags">
        {project.tags.slice(0, 4).map((t) => <Pill tone="accent">{t}</Pill>)}
      </div>
      <span class="cta">View case study <span aria-hidden="true">→</span></span>
    </div>
  </a>
</article>

<style>
  .link {
    display: block;
    text-decoration: none;
  }
  .media {
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--color-line);
    aspect-ratio: 4 / 3;
  }
  .media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 900ms var(--ease);
  }
  .link:hover .media img {
    transform: scale(1.04);
  }
  .body {
    padding-top: var(--space-6);
  }
  h3 {
    margin-top: var(--space-2);
    font-size: var(--text-xl);
  }
  .summary {
    margin-top: var(--space-3);
    color: var(--color-muted);
    font-size: var(--text-sm);
    max-width: 48ch;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }
  .cta {
    display: inline-block;
    margin-top: var(--space-6);
    font-size: var(--text-sm);
    font-weight: 500;
    border-bottom: 1px solid currentColor;
  }
  .cta span {
    display: inline-block;
    transition: transform var(--duration) var(--ease);
  }
  .link:hover .cta span {
    transform: translateX(4px);
  }
</style>
