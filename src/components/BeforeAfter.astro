---
// Comparador antes / después: se arrastra la línea para destapar una imagen u otra.
interface Props {
  before: string;
  after: string;
  beforeAlt: string;
  afterAlt: string;
  ratio?: string;
  /** Qué parte de las imágenes se ve si el marco las recorta (object-position) */
  position?: string;
  /** Lo mismo, solo para la imagen de después (por defecto usa `position`) */
  afterPosition?: string;
}
const { before, after, beforeAlt, afterAlt, ratio = '1164 / 824', position = 'left top', afterPosition } = Astro.props;
---

<div class="ba" data-before-after style={`aspect-ratio:${ratio}; --focus:${position}`}>
  <img src={after} alt={afterAlt} loading="lazy" style={afterPosition ? `object-position:${afterPosition}` : undefined} />
  <div class="clip">
    <img src={before} alt={beforeAlt} loading="lazy" />
  </div>
  <span class="tag is-before" aria-hidden="true">Before</span>
  <span class="tag is-after" aria-hidden="true">After</span>
  <span class="line" aria-hidden="true">
    <span class="handle">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 7-5 5 5 5M15 7l5 5-5 5" /></svg>
    </span>
  </span>
  <input type="range" min="0" max="100" value="50" aria-label="Drag to compare before and after" />
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-before-after]').forEach((el) => {
    const range = el.querySelector<HTMLInputElement>('input');
    if (!range) return;
    const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let touched = false;

    const set = (value: number) => el.style.setProperty('--pos', `${value}%`);
    const stopHint = () => {
      touched = true;
      el.classList.add('is-used');
    };
    range.addEventListener('input', () => {
      stopHint();
      set(Number(range.value));
    });
    range.addEventListener('pointerdown', stopHint);

    // La primera vez que entra en pantalla, la línea se mueve sola de lado a lado
    // para mostrar que se puede arrastrar. Se corta apenas la persona la toca.
    if (still) return;
    new IntersectionObserver(
      ([entry], observer) => {
        if (!entry.isIntersecting) return;
        observer.disconnect();
        const start = performance.now();
        const demo = (now: number) => {
          if (touched) return;
          const t = Math.min(1, (now - start) / 2200);
          const value = 50 + Math.sin(t * Math.PI * 2) * 16 * (1 - t * 0.4);
          set(value);
          range.value = String(value);
          if (t < 1) requestAnimationFrame(demo);
          else {
            set(50);
            range.value = '50';
          }
        };
        window.setTimeout(() => requestAnimationFrame(demo), 500);
      },
      { threshold: 0.6 },
    ).observe(el);
  });
</script>

<style>
  .ba {
    --pos: 50%;
    position: relative;
    overflow: hidden;
    background: var(--color-line);
    box-shadow: inset 0 0 0 1px var(--color-line);
  }
  img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--focus, left top);
  }
  /* la imagen de "antes" se ve solo a la izquierda de la línea */
  .clip {
    position: absolute;
    inset: 0;
    clip-path: inset(0 calc(100% - var(--pos)) 0 0);
  }
  /* Línea fina y un círculo blanco con dos flechas: el mismo lenguaje que los cursores del sitio */
  .line {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    width: 1px;
    margin-left: -0.5px;
    background: var(--color-text);
  }
  .handle {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--color-text);
    border-radius: 50%;
    background: var(--color-bg);
    color: var(--color-text);
    translate: -50% -50%;
  }
  /* Etiquetas: texto chico sobre blanco, sin pastilla */
  .tag {
    position: absolute;
    top: 0;
    padding: 0.6em 0.9em;
    background: var(--color-bg);
    color: var(--color-text);
    font-size: var(--text-2xs);
    letter-spacing: 0.08em;
    line-height: 1;
    text-transform: uppercase;
  }
  .is-before {
    left: 0;
  }
  .is-after {
    right: 0;
  }
  /* el control real es un range invisible que ocupa toda la imagen */
  input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
  }
  input:focus-visible ~ .line .handle,
  .ba:has(input:focus-visible) .handle {
    outline: 1px solid var(--color-text);
    outline-offset: 4px;
  }
</style>
