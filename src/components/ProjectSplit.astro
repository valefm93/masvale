---
// Estructura de dos columnas de las páginas de proyecto hechas a mano:
// texto angosto a la izquierda (fijo, con su propio scroll) y piezas a la derecha.
//   slot "text"  → párrafos de descripción
//   slot "extra" → lo que vaya debajo de las tags (opcional)
//   slot normal  → la columna derecha
import Pill from './Pill.astro';
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}
const { project } = Astro.props;
---

<div class="container simple">
  <div class="side" data-reveal>
    <p class="col-label"><span>Project</span></p>
    <a class="back" href="/portfolio">← All projects</a>
    <p class="eyebrow">{project.client}</p>
    <h1>{project.title}</h1>
    <div class="side-text">
      <slot name="text" />
    </div>
    <div class="tags">{project.tags.map((t) => <Pill tone="accent">{t}</Pill>)}</div>
    <slot name="extra" />
  </div>

  <div class="media">
    <p class="col-label"><span>Work</span><span>{project.categories.join(' / ')}</span></p>
    <slot />
  </div>
</div>

<style>
  /*
    Estilo suizo: nada de cajas ni fondos. Las columnas se distinguen por la
    grilla: una línea fina vertical entre ambas y una etiqueta pequeña arriba
    de cada una, como el margen y el cuerpo de una página impresa.
  */
  .simple {
    display: grid;
    grid-template-columns: var(--col-4) minmax(0, 1fr);
    gap: 0;
    align-items: start;
    padding-block: 0 var(--space-section);
  }
  .col-label {
    display: flex;
    justify-content: space-between;
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--color-line);
    font-size: var(--text-2xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  /*
    La columna de texto queda fija y tiene su propio scroll: se recorre
    por separado de la columna de la derecha, que avanza con la página.
  */
  .side {
    position: sticky;
    top: 64px;
    max-height: calc(100svh - 64px);
    padding: 0 var(--grid-gap) var(--space-8) 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: var(--color-line) transparent;
  }
  .side .col-label {
    margin-right: calc(var(--grid-gap) * -1);
    margin-bottom: var(--space-8);
  }
  .back {
    display: inline-block;
    margin-bottom: var(--space-8);
    font-size: var(--text-sm);
    color: var(--color-muted);
    text-decoration: none;
  }
  .back:hover {
    color: var(--color-text);
  }
  h1 {
    margin-top: var(--space-3);
    font-size: var(--text-xl);
  }
  .side-text {
    display: grid;
    gap: var(--space-4);
    max-width: 62ch;
    margin-top: var(--space-6);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-8);
  }
  .media {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--grid-gap);
    min-width: 0;
    padding-left: var(--grid-gap);
    border-left: 1px solid var(--color-line);
  }
  .media .col-label {
    margin-left: calc(var(--grid-gap) * -1);
    padding-left: var(--grid-gap);
  }
  /* nada dentro de la columna puede ensancharla (por ejemplo una tira con scroll lateral) */
  .media > :global(*) {
    min-width: 0;
  }
  @media (max-width: 860px) {
    .simple {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
    .side {
      position: static;
      max-height: none;
      padding: 0;
      overflow: visible;
    }
    .side .col-label {
      margin-right: 0;
    }
    .media {
      padding-left: 0;
      border-left: 0;
    }
    .media .col-label {
      margin-left: 0;
      padding-left: 0;
    }
  }
</style>
