---
// Estructura de dos columnas de las páginas de proyecto hechas a mano:
// texto angosto a la izquierda (fijo, con su propio scroll) y piezas a la derecha.
//   slot "text"  → párrafos de descripción
//   slot "extra" → lo que vaya debajo de las tags (opcional)
//   slot normal  → la columna derecha
import Pill from './Pill.astro';
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}
const { project } = Astro.props;
---

<div class="container simple">
  <div class="side" data-reveal data-side>
    <p class="col-label"><span>Project</span></p>
    <a class="back" href="/portfolio" data-back>← All projects</a>
    <p class="eyebrow">{project.client}</p>
    <h1>{project.title}</h1>
    {
      /* Todas las páginas arrancan igual: problema, solución, rol, skills y metodología; después, el resto */
      project.brief ? (
        <dl class="brief">
          <div>
            <dt>Problem</dt>
            <dd>{project.brief.problem}</dd>
          </div>
          <div>
            <dt>Solution</dt>
            <dd>{project.brief.solution}</dd>
          </div>
          <div>
            <dt>My role</dt>
            <dd>{project.brief.role}</dd>
          </div>
          <div>
            <dt>Skills</dt>
            <dd class="tags">
              {project.tags.map((t) => (
                <Pill tone="accent">{t}</Pill>
              ))}
            </dd>
          </div>
          <div>
            <dt>Methodology</dt>
            <dd>{project.brief.methodology}</dd>
          </div>
        </dl>
      ) : (
        <div class="tags">
          {project.tags.map((t) => (
            <Pill tone="accent">{t}</Pill>
          ))}
        </div>
      )
    }
    <div class="side-text">
      <slot name="text" />
    </div>
    <slot name="extra" />
  </div>

  <div class="media">
    <p class="col-label"><span>Work</span><span>{project.categories.join(' / ')}</span></p>
    <slot />
    <!-- Volver arriba, al final de la columna de trabajo (igual que en About me) -->
    <p class="to-top">
      <a href="#top">
        <span>Back to top</span>
        <svg class="up" viewBox="0 0 16 16" aria-hidden="true">
          <path d="M8 13V3M3.5 7.5 8 3l4.500 4.500" fill="none" stroke="currentColor" stroke-width="1.25" />
        </svg>
      </a>
    </p>
  </div>
</div>

<script>
  // Marca "← All projects" cuando ya quedó fijo arriba (para mostrarle la línea de abajo)
  const side = document.querySelector<HTMLElement>('[data-side]');
  const back = side?.querySelector<HTMLElement>('[data-back]');
  if (side && back) {
    const start = back.offsetTop;
    const update = () => back.classList.toggle('is-stuck', side.scrollTop >= start - 1);
    side.addEventListener('scroll', update, { passive: true });
    update();
  }
</script>

<style>
  /*
    Estilo suizo: nada de cajas ni fondos. Las columnas se distinguen por la
    grilla: una línea fina vertical entre ambas y una etiqueta pequeña arriba
    de cada una, como el margen y el cuerpo de una página impresa.
  */
  .simple {
    display: grid;
    grid-template-columns: var(--col-4) minmax(0, 1fr);
    gap: 0;
    align-items: start;
    padding-block: 0;
  }
  .col-label {
    display: flex;
    justify-content: space-between;
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--color-line);
    font-size: var(--text-2xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  /*
    La columna de texto queda fija y tiene su propio scroll: se recorre
    por separado de la columna de la derecha, que avanza con la página.
  */
  .side {
    position: sticky;
    top: 64px;
    max-height: calc(100svh - 64px);
    padding: 0 var(--grid-gap) var(--space-8) 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: var(--color-line) transparent;
  }
  .side .col-label {
    margin-right: calc(var(--grid-gap) * -1);
    margin-bottom: var(--space-4);
  }
  /*
    "← All projects" sube con el texto y, cuando la columna empieza a correr,
    se queda fijo arriba, a la altura de la etiqueta "Work" de la otra columna.
  */
  .back {
    position: sticky;
    top: 0;
    z-index: 2;
    display: block;
    margin-right: calc(var(--grid-gap) * -1);
    margin-bottom: var(--space-6);
    padding-block: var(--space-3);
    border-bottom: 1px solid transparent;
    background: var(--color-bg);
    font-size: var(--text-2xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
    text-decoration: none;
    transition: border-color var(--duration) var(--ease);
  }
  .back.is-stuck {
    border-bottom-color: var(--color-line);
  }
  .back:hover {
    color: var(--color-text);
  }
  /* Título del proyecto: mismo estilo que el H1 de la página Projects */
  h1 {
    margin-top: var(--space-3);
    font-size: var(--text-xl);
    text-wrap: balance;
  }
  /* Resumen del proyecto: etiqueta chica arriba y el texto debajo, separados por líneas finas */
  .brief {
    display: grid;
    margin: var(--space-6) 0 0;
  }
  .brief > div {
    display: grid;
    gap: var(--space-1, 0.25rem);
    padding-block: var(--space-4);
    border-top: 1px solid var(--color-line);
  }
  .brief dt {
    font-size: var(--text-2xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .brief dd {
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.5;
  }
  .brief dd.tags {
    margin-top: var(--space-1, 0.25rem);
  }
  .side-text {
    display: grid;
    gap: var(--space-4);
    max-width: 62ch;
    margin-top: var(--space-6);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-8);
  }
  /* Columna de trabajo sobre blanco: el blanco llega hasta el borde derecho de la pantalla
     (la sombra lo extiende; el recorte evita que se escape hacia la izquierda) */
  .media {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-content: start;
    align-self: stretch;
    gap: var(--grid-gap);
    min-width: 0;
    padding-left: var(--grid-gap);
    padding-bottom: var(--space-section);
    border-left: 1px solid var(--color-line);
    background: var(--white);
    box-shadow: 0 0 0 100vmax var(--white);
    clip-path: inset(0 -100vmax 0 0);
  }
  .media .col-label {
    margin-left: calc(var(--grid-gap) * -1);
    padding-left: var(--grid-gap);
  }
  /* Esquinas redondeadas en los contenedores e imágenes de la columna de trabajo
     (bloques de fondo de cada caso, capturas, comparadores antes/después, tarjetas de los kits) */
  .media {
    --r-box: 14px;
  }
  .media
    :global(
      :is(
          .panel,
          .showcase,
          .strip-wrap,
          .kit,
          .stage,
          .ds,
          .flow,
          .sides,
          .shift,
          .result,
          .uses,
          .ba,
          .hero-shot img,
          img.shot,
          .group img,
          .shots img,
          .kit-grid .card,
          .ds-grid .card,
          .guide img
        )
    ) {
    border-radius: var(--r-box);
  }
  /* los que tienen contenido pegado al borde recortan sus esquinas */
  .media :global(:is(.panel, .sides, .shift, .result, .uses, .ba)) {
    overflow: hidden;
  }
  /* nada dentro de la columna puede ensancharla (por ejemplo una tira con scroll lateral) */
  .media > :global(*) {
    min-width: 0;
  }
  .to-top {
    display: flex;
    justify-content: flex-end;
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-line);
  }
  .to-top a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .up {
    box-sizing: content-box;
    width: 1rem;
    height: 1rem;
    padding: 0.75rem;
    border: 1px solid currentColor;
    border-radius: 50%;
    transition:
      background var(--duration) var(--ease),
      border-color var(--duration) var(--ease),
      translate var(--duration) var(--ease);
  }
  .to-top a:hover .up {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-on-accent);
    translate: 0 -4px;
  }
  @media (max-width: 860px) {
    .simple {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
    .side {
      position: static;
      max-height: none;
      padding: 0;
      overflow: visible;
    }
    .side .col-label {
      margin-right: 0;
    }
    .back {
      position: static;
      margin-right: 0;
    }
    .media {
      padding-left: 0;
      border-left: 0;
      clip-path: inset(0 -100vmax);
    }
    .media .col-label {
      margin-left: 0;
      padding-left: 0;
    }
  }
</style>
