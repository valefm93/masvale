---
// Hero de la home: fondo papel (#E9E3D4) con ilustraciones dibujadas por Vale, su firma y "Product Designer".
// Todo vive en un lienzo de 1220 × 868 (el tamaño del diseño) que cubre la pantalla, como una portada.
// Al pasar el mouse, las ilustraciones giran un poquito, y se pueden arrastrar a otro lugar.
import { nav } from '../data/site';

interface Props {
  contactHref?: string;
}
const { contactHref = '#contact' } = Astro.props;

const img = (name: string) => `/images/home/${name}.png`;

type Doodle = { name: string; x: number; y: number; w: number; ratio: number; rot?: number };
type Layout = {
  key: 'desk' | 'mob';
  W: number;
  H: number;
  doodles: Doodle[];
  hLines: number[];
  vLines: number[];
  date: { x: number; y: number };
  based?: { x: number; y: number };
  sig: { x: number; y: number; w: number };
  title: { x: number; lines: { text: string; y: number }[] };
};
const R = { glasses: 304 / 548, card: 576 / 640, star: 720 / 715, bulb: 340 / 322, squiggle: 152 / 491, flower: 494 / 382, cup: 396 / 377, pencil: 297 / 135, laptop: 916 / 856 };

// Escritorio: lienzo de 1488 × 1060 (la ubicación que Vale armó arrastrándolas).
// x, y, ancho en px del lienzo; el alto sale de la proporción de cada archivo. rot: giro en grados.
const desk: Layout = {
  key: 'desk',
  W: 1488,
  H: 1060,
  doodles: [
    { name: 'glasses', x: 415.6, y: 32.4, w: 205.3, ratio: R.glasses },
    { name: 'card', x: 844.1, y: -24.9, w: 254.0, ratio: R.card, rot: -9 },
    { name: 'star', x: 79.7, y: 209.1, w: 268.3, ratio: R.star },
    { name: 'bulb', x: 1226.9, y: 132.8, w: 120.1, ratio: R.bulb },
    { name: 'squiggle', x: 662.3, y: 905.4, w: 217.9, ratio: R.squiggle },
    { name: 'flower', x: 314.2, y: 830.2, w: 142.4, ratio: R.flower },
    { name: 'cup', x: 77.0, y: 659.2, w: 140.2, ratio: R.cup },
    { name: 'pencil', x: 1325.2, y: 369.2, w: 82.0, ratio: R.pencil },
    { name: 'laptop', x: 1096.6, y: 626.1, w: 322.6, ratio: R.laptop },
  ],
  hLines: [65.5, 73.5, 455.5, 480.5, 505.5, 563.5, 992.5],
  vLines: [78.5, 343, 1151.5, 1412],
  date: { x: 1412, y: 74 },
  based: { x: 94, y: 993 },
  sig: { x: 499, y: 396.3, w: 472.4 },
  title: { x: 745.5, lines: [{ text: 'Product Designer', y: 557 }] },
};

// Celular: lienzo vertical de 390 × 844 con los mismos dibujos alrededor del título en dos líneas
// (sin "Based in Paris")
const mob: Layout = {
  key: 'mob',
  W: 390,
  H: 844,
  doodles: [
    { name: 'glasses', x: 140, y: 62, w: 105, ratio: R.glasses },
    { name: 'card', x: 258, y: 170, w: 128, ratio: R.card, rot: -9 },
    { name: 'star', x: -28, y: 128, w: 142, ratio: R.star },
    { name: 'bulb', x: 304, y: 70, w: 60, ratio: R.bulb },
    { name: 'squiggle', x: 125, y: 612, w: 140, ratio: R.squiggle },
    { name: 'flower', x: 132, y: 690, w: 72, ratio: R.flower },
    { name: 'cup', x: 34, y: 712, w: 84, ratio: R.cup },
    { name: 'pencil', x: 22, y: 596, w: 34, ratio: R.pencil },
    { name: 'laptop', x: 222, y: 652, w: 178, ratio: R.laptop },
  ],
  hLines: [44, 50, 368, 446, 512, 818],
  vLines: [16, 374],
  date: { x: 374, y: 34 },
  sig: { x: 70, y: 300, w: 250 },
  title: {
    x: 195,
    lines: [
      { text: 'Product', y: 432 },
      { text: 'Designer', y: 500 },
    ],
  },
};
const layouts = [desk, mob];

// centro de la espiral de cada lienzo: de ahí salen todas las ilustraciones al entrar
const originOf = (l: Layout) => {
  const sq = l.doodles.find((d) => d.name === 'squiggle')!;
  return { x: sq.x + sq.w / 2, y: sq.y + (sq.w * sq.ratio) / 2 };
};
---

<section class="sketch is-entering" data-sketch>
  <h1 class="visually-hidden">Valeria Ferreira, Product Designer</h1>

  {
    layouts.map((l) => {
      const origin = originOf(l);
      return (
        <svg
          class:list={['canvas', `is-${l.key}`]}
          viewBox={`0 0 ${l.W} ${l.H}`}
          preserveAspectRatio="xMidYMid slice"
          aria-hidden="true"
        >
          <g class="rules">
            {l.hLines.map((y) => (
              <line class="rule is-h" x1="-40" x2={l.W + 40} y1={y} y2={y} />
            ))}
            {l.vLines.map((x) => (
              <line class="rule is-v" x1={x} x2={x} y1="-40" y2={l.H + 40} />
            ))}
          </g>

          <text class="date" x={l.date.x} y={l.date.y} text-anchor="end" data-date>
            Last update
          </text>
          {l.based && (
            <text class="based" transform={`translate(${l.based.x} ${l.based.y}) rotate(-90)`}>
              BASED IN PARIS
            </text>
          )}

          {l.doodles.map((d, i) => (
            <g
              class:list={['orbit', { 'is-source': d.name === 'squiggle' }]}
              style={`--i:${i};transform-origin:${origin.x}px ${origin.y}px`}
            >
              <g class="doodle">
                {/* el giro fijo (la tarjeta) va en un grupo aparte, para no mezclarse con el balanceo */}
                <g transform={d.rot ? `rotate(${d.rot} ${d.x + d.w / 2} ${d.y + (d.w * d.ratio) / 2})` : undefined}>
                  <image class="ink" href={img(d.name)} x={d.x} y={d.y} width={d.w} height={d.w * d.ratio} />
                </g>
              </g>
            </g>
          ))}

          <image class="signature" href={img('signature')} x={l.sig.x} y={l.sig.y} width={l.sig.w} height={l.sig.w * (281 / 1066)} />
          <text class="title" text-anchor="middle">
            {l.title.lines.map((line) => (
              <tspan x={l.title.x} y={line.y}>
                {line.text}
              </tspan>
            ))}
          </text>
        </svg>
      );
    })
  }

  <!-- Botones del menú -->
  <nav class="hero-nav" aria-label="Main">
    {nav.map((item) => <a href={item.href === '#contact' ? contactHref : item.href}>{item.label}</a>)}
  </nav>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-sketch]');
  if (root) {
    // Fecha de hoy, en inglés: "Last update, Tuesday 14 October"
    const today = new Date();
    const stamp =
      `Last update, ${today.toLocaleDateString('en-GB', { weekday: 'long' })} ` +
      `${String(today.getDate()).padStart(2, '0')} ${today.toLocaleDateString('en-GB', { month: 'long' })}`;
    root.querySelectorAll('[data-date]').forEach((d) => (d.textContent = stamp));

    // la entrada dura cerca de 2 segundos; después se quita la clase
    window.setTimeout(() => root.classList.remove('is-entering'), 3200);

    // Si el visitante intenta bajar y no hay nada debajo, los botones dan un saltito invitando a hacer clic
    const still = window.matchMedia('(prefers-reduced-motion: reduce)');
    const navEl = root.querySelector<HTMLElement>('.hero-nav');
    const nudge = () => {
      if (!navEl || still.matches || navEl.classList.contains('is-nudging')) return;
      const atEnd = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
      if (!atEnd) return;
      navEl.classList.add('is-nudging');
      window.setTimeout(() => navEl.classList.remove('is-nudging'), 900);
    };
    window.addEventListener('wheel', (e) => e.deltaY > 0 && nudge(), { passive: true });
    window.addEventListener('keydown', (e) => ['ArrowDown', 'PageDown', ' '].includes(e.key) && nudge());
    let touchY = 0;
    window.addEventListener('touchstart', (e) => (touchY = e.touches[0].clientY), { passive: true });
    window.addEventListener('touchmove', (e) => touchY - e.touches[0].clientY > 24 && nudge(), { passive: true });

    // Las ilustraciones se pueden arrastrar: el movimiento se pasa a unidades del lienzo
    // y la que se agarra pasa al frente
    root.querySelectorAll<SVGGElement>('.doodle').forEach((g) => {
      let x = 0;
      let y = 0;
      let from: { px: number; py: number; x: number; y: number; k: number } | null = null;
      g.addEventListener('pointerdown', (e) => {
        const k = g.ownerSVGElement?.getScreenCTM()?.a || 1;
        from = { px: e.clientX, py: e.clientY, x, y, k };
        g.setPointerCapture(e.pointerId);
        g.classList.add('is-held');
        const orbit = g.closest('.orbit');
        orbit?.parentNode?.appendChild(orbit);
        e.preventDefault();
      });
      g.addEventListener('pointermove', (e) => {
        if (!from) return;
        x = from.x + (e.clientX - from.px) / from.k;
        y = from.y + (e.clientY - from.py) / from.k;
        g.style.translate = `${x}px ${y}px`;
      });
      const drop = () => {
        from = null;
        g.classList.remove('is-held');
      };
      g.addEventListener('pointerup', drop);
      g.addEventListener('pointercancel', drop);
    });

    // Header.astro usa este estado para aparecer cuando el hero ya pasó
    const update = () => {
      document.documentElement.dataset.heroState = root.getBoundingClientRect().bottom <= 64 ? 'past' : 'start';
    };
    window.addEventListener('scroll', update, { passive: true });
    update();
  }
</script>

<style>
  .sketch {
    /* un px del lienzo, con la misma escala "cover" del SVG */
    /* lienzo activo (escritorio) y altura de los botones en ese lienzo */
    --W: 1488;
    --H: 1060;
    --navY: 628;
    --px: max(100vw / var(--W), 100svh / var(--H));
    --paper: var(--color-bg);
    --ink: #1e1e1e;
    position: relative;
    z-index: 1;
    height: 100svh;
    overflow: hidden;
    background: var(--paper);
    color: var(--ink);
  }
  .canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* Grilla: horizontales lisas, verticales punteadas */
  .rule {
    stroke: var(--gray-light);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  .rule.is-v {
    stroke-dasharray: 4 4;
  }

  .date {
    font-size: 14px;
    letter-spacing: 0.2em;
    fill: var(--ink);
  }
  .based {
    font-size: 14px;
    letter-spacing: 1.05em;
    fill: var(--ink);
  }
  .title {
    font-family: var(--font-body);
    font-size: 95px;
    font-weight: 700;
    letter-spacing: -0.035em;
    fill: var(--ink);
  }

  /* Ilustraciones: al pasar el mouse giran un poquito */
  .doodle {
    transform-box: fill-box;
    transform-origin: center;
    transition:
      rotate 400ms cubic-bezier(0.3, 1.6, 0.5, 1),
      scale 200ms ease;
  }
  .doodle {
    cursor: grab;
    touch-action: none;
  }
  .doodle:hover {
    rotate: -4deg;
  }
  .doodle.is-held {
    cursor: grabbing;
    rotate: -6deg;
    scale: 1.06;
    filter: drop-shadow(0 6px 8px rgb(30 30 30 / 0.18));
  }

  /* Entrada: las ilustraciones aparecen una por una, la firma se escribe y el título sube */
  /* Entrada: la espiral aparece primero y de ella salen todas las ilustraciones, girando en espiral
     alrededor de su centro mientras crecen hasta su lugar */
  .orbit {
    transform-box: view-box;
  }
  .sketch.is-entering .orbit {
    animation: spiral-out 1300ms cubic-bezier(0.25, 0.8, 0.3, 1) calc(700ms + var(--i) * 90ms) both;
  }
  .sketch.is-entering .orbit.is-source {
    animation: pop 600ms cubic-bezier(0.3, 1.5, 0.5, 1) 300ms both;
    transform-box: fill-box;
    transform-origin: center !important;
  }
  @keyframes spiral-out {
    from {
      opacity: 0;
      scale: 0;
      rotate: -240deg;
    }
    25% {
      opacity: 1;
    }
  }
  /* Después siguen girando muy levemente, cada una a su ritmo */
  .doodle .ink {
    transform-box: fill-box;
    transform-origin: center;
    animation: sway calc(5s + var(--i) * 0.7s) ease-in-out calc(var(--i) * -1.3s) infinite alternate;
  }
  @keyframes sway {
    from {
      rotate: -2.5deg;
    }
    to {
      rotate: 2.5deg;
    }
  }
  .sketch.is-entering .signature {
    animation: write 1100ms cubic-bezier(0.6, 0, 0.3, 1) 200ms both;
  }
  .sketch.is-entering .title {
    animation: rise 800ms cubic-bezier(0.2, 0.7, 0.2, 1) 500ms both;
  }
  .sketch.is-entering .rules {
    animation: fade 900ms ease both;
  }
  .sketch.is-entering .date,
  .sketch.is-entering .based {
    animation: fade 700ms ease 1200ms both;
  }
  @keyframes pop {
    from {
      opacity: 0;
      scale: 0.6;
      rotate: -12deg;
    }
  }
  @keyframes write {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }
  @keyframes rise {
    from {
      opacity: 0;
      translate: 0 24px;
    }
  }
  @keyframes fade {
    from {
      opacity: 0;
    }
  }

  /* Botones del menú, entre el título y la espiral (y = --navY del lienzo activo) */
  .hero-nav {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(50% + (var(--navY) - var(--H) / 2) * var(--px));
    z-index: 3;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding-inline: var(--gutter);
    translate: 0 -50%;
    color: var(--ink);
    pointer-events: none;
  }
  .hero-nav a {
    padding: 0.75em 1.5em;
    border: 1px solid currentColor;
    border-radius: var(--radius-pill);
    background: rgb(242 238 230 / 0.6);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    font-size: var(--text-xs);
    line-height: 1;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    text-decoration: none;
    pointer-events: auto;
    transition:
      background var(--duration) var(--ease),
      color var(--duration) var(--ease),
      border-color var(--duration) var(--ease);
  }
  .hero-nav a:hover {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-on-accent);
  }
  .sketch.is-entering .hero-nav a {
    animation: rise-btn 600ms cubic-bezier(0.2, 0.7, 0.2, 1) 1450ms both;
  }
  .sketch.is-entering .hero-nav a:nth-child(2) {
    animation-delay: 1530ms;
  }
  .sketch.is-entering .hero-nav a:nth-child(3) {
    animation-delay: 1610ms;
  }
  @keyframes rise-btn {
    from {
      opacity: 0;
      translate: 0 14px;
    }
  }
  /* Saltito de invitación: suben uno tras otro y vuelven */
  .hero-nav.is-nudging a {
    animation: nudge 700ms cubic-bezier(0.3, 0, 0.2, 1);
  }
  .hero-nav.is-nudging a:nth-child(2) {
    animation-delay: 70ms;
  }
  .hero-nav.is-nudging a:nth-child(3) {
    animation-delay: 140ms;
  }
  @keyframes nudge {
    35% {
      translate: 0 -18px;
    }
    70% {
      translate: 0 3px;
    }
  }

  /* Dos lienzos: el horizontal en pantallas anchas y el vertical en celulares (pantallas verticales) */
  .canvas.is-mob {
    display: none;
  }
  .is-mob .title {
    font-size: 76px;
    letter-spacing: -0.04em;
  }
  .is-mob .date {
    font-size: 9px;
    letter-spacing: 0.16em;
  }
  @media (max-aspect-ratio: 4 / 5) {
    .sketch {
      --W: 390;
      --H: 844;
      --navY: 566;
    }
    .canvas.is-desk {
      display: none;
    }
    .canvas.is-mob {
      display: block;
    }
    /* los tres botones en una sola fila */
    .hero-nav {
      flex-wrap: nowrap;
      gap: 6px;
      padding-inline: 12px;
    }
    .hero-nav a {
      padding: 0.75em 1em;
      white-space: nowrap;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sketch.is-entering *,
    .doodle .ink {
      animation: none !important;
    }
  }
</style>
