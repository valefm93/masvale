---
import { nav } from '../data/site';

interface Props {
  /** Flota transparente sobre el hero de la home (el estado lo marca Hero.astro en <html data-hero-state>) */
  overlay?: boolean;
}
const { overlay = false } = Astro.props;
const path = Astro.url.pathname;
const isActive = (href: string) => href.startsWith('/') && path.startsWith(href);
---

<header class:list={['header', { overlay }]}>
  <div class="container inner">
    <a class="logo" href="/" aria-label="Vale Ferreira, home">
      <img src="/images/home/signature.png" alt="" width="1066" height="281" />
    </a>
    <nav aria-label="Main">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--color-bg) 85%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-line);
  }
  /* En la home: escondido mientras dura el hero, aparece al terminar (lo marca Hero.astro) */
  .overlay {
    position: fixed;
    left: 0;
    right: 0;
    transition:
      translate var(--duration) var(--ease),
      visibility var(--duration);
  }
  :global(html:not([data-hero-state='past'])) .overlay {
    translate: 0 -100%;
    visibility: hidden;
  }
  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 64px;
  }
  /* Logo: la firma de Vale */
  .logo {
    display: block;
    text-decoration: none;
  }
  .logo img {
    display: block;
    width: auto;
    height: 1.9rem;
  }
  nav a {
    white-space: nowrap;
  }
  ul {
    display: flex;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* Mismo estilo que los botones del hero */
  nav a {
    display: block;
    padding: 0.75em 1.5em;
    border: 1px solid currentColor;
    border-radius: var(--radius-pill);
    font-size: var(--text-xs);
    line-height: 1;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    text-decoration: none;
    transition:
      background var(--duration) var(--ease),
      border-color var(--duration) var(--ease),
      color var(--duration) var(--ease);
  }
  nav a:hover {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-on-accent);
  }
  nav a[aria-current='page'] {
    background: var(--color-text);
    border-color: var(--color-text);
    color: var(--color-bg);
  }
  @media (max-width: 540px) {
    .logo img {
      height: 1.3rem;
    }
    ul {
      gap: var(--space-1);
    }
    nav a {
      padding: 0.6em 0.75em;
      font-size: var(--text-2xs);
    }
  }
</style>
