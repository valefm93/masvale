---
interface Props {
  tone?: 'default' | 'accent';
}
const { tone = 'default' } = Astro.props;
---

<span class:list={['pill', tone]}><slot /></span>

<style>
  .pill {
    display: inline-flex;
    align-items: center;
    padding: 0.3em 0.75em;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    font-size: var(--text-2xs);
    line-height: 1.4;
    white-space: nowrap;
  }
  /* tags de los proyectos: tono piedra (#9C9381 aclarado) con texto oscuro, para que se lea bien */
  .accent {
    border-color: transparent;
    background: var(--color-stone);
    color: var(--color-text);
  }
</style>
