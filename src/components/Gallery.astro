---
// Carrusel horizontal con scroll nativo (funciona con trackpad, touch y teclado).
interface Props {
  images: { src: string; alt: string }[];
  label?: string;
}
const { images, label = 'Image gallery' } = Astro.props;
---

<div class="gallery" role="region" aria-label={label} tabindex="0">
  {
    images.map((img) => (
      <figure>
        <img src={img.src} alt={img.alt} loading="lazy" />
      </figure>
    ))
  }
</div>

<style>
  .gallery {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(82%, 52rem);
    gap: var(--space-4);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    /* alinea el primer slide con el margen del contenido */
    --edge: max(var(--gutter), calc((100vw - var(--container)) / 2 + var(--gutter)));
    scroll-padding-inline: var(--edge);
    padding-inline: var(--edge);
    padding-bottom: var(--space-4);
    scrollbar-width: thin;
  }
  figure {
    margin: 0;
    scroll-snap-align: start;
    overflow: hidden;
    background: var(--color-line);
  }
  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
